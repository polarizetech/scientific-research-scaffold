#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""scaffold: create studies, sims and apps in the shape PROTOCOL.md describes, and check existing repos.

  scaffold new study <name> --question "..." --hypothesis "..." [--profile NAME] [--visibility public|private] [--dir PARENT]
  scaffold new workbench <name> --question "the theme"
  scaffold new study <name> --question "..." --inside WORKBENCH
  scaffold new sim <name> --question "..." [--inside STUDY|WORKBENCH]
  scaffold new sim|dataset <name> -q "..." --inside|--study TOOL --compares "OTHER X.Y"   a comparison unit
  scaffold new tool <name> --job "..."
  scaffold new app <slug> --question "..." [--study PATH] [--hypothesis-element ID ...]
  scaffold new dataset <slug> --question "..." [--study PATH] [--hypothesis-element ID ...]
  scaffold new calculator <slug> --question "what it computes" [--study PATH] [--hypothesis-element ID ...]
  scaffold new app|sim|tool|dataset|calculator ... --exploratory    no claim yet: a build note instead
  scaffold promote-sim <study>/sims/<slug>
  scaffold link-hypothesis <unit-path> --element ID [--element ID ...] --role "..." [--path STUDY]
  scaffold sync-hypothesis [PATH ...]
  scaffold check [PATH]
  scaffold status [PATH ...]
  scaffold update [PATH] [--apply] [--adopt FILE]
  scaffold usage [PATH ...] [--days N] [--all]
  scaffold version [PATH] [--hook] [--offline]
  scaffold profiles

Stdlib only (Python 3.9+). Needs git. `new` installs the preregistration kit when it can find kit_ap
(--kit-ap PATH, $KIT_AP, or a sibling checkout of the profile's prereg repo); otherwise it says how.
There is no default profile: pass --profile NAME or set $SCAFFOLD_PROFILE. Visibility is left undecided
unless --visibility is given, and `check` fails until it is decided.
"""
import argparse

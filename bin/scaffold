PROFILES = HERE / "profiles"

KINDS = ("study", "sim", "tool", "workbench")
#: Kinds that hold units (apps, sims, tools, datasets, calculators), and so can be given to --inside.
CONTAINERS = ("study", "workbench")
#: The release that generated CI checks out, and that `.scaffold.lock` records.
SCAFFOLD_REF = "v0.11.1"
LOCK = ".scaffold.lock"
#: scientific-research-agents, a submodule pinned to a tag: the agent briefs, discipline briefs and the
#: AGENTS.md section. `git submodule update --init` fetches it.
AGENTS_DIR = HERE / "agents"
#: The specialist agents each kind gets, from scientific-research-agents. A sim has no UI, so no UI agents.
AGENTS = {
    "study": ("scout", "computational-engineer", "mathematician", "designer", "frontend-developer", "researcher",
              "analyst", "science-writer"),
    "sim": ("scout", "computational-engineer", "mathematician", "researcher", "analyst", "science-writer"),
    "tool": ("scout", "computational-engineer", "mathematician", "designer", "frontend-developer", "researcher",
             "analyst", "science-writer"),
    "workbench": ("scout", "computational-engineer", "mathematician", "designer", "frontend-developer", "researcher",
                  "analyst", "science-writer"),
}
#: Each agent's starting model and effort (agents/COORDINATION.md: start cheap, escalate on a signal). A
#: profile overrides any of them in [agents.routing], as "model" or "model:effort".
ROUTING = {
    "scout": ("haiku", "low"),
    "computational-engineer": ("sonnet", "high"),
    "mathematician": ("sonnet", "high"),
    "designer": ("sonnet", "medium"),
    "frontend-developer": ("sonnet", "medium"),
    "researcher": ("sonnet", "medium"),
    "analyst": ("sonnet", "high"),
    "science-writer": ("sonnet", "medium"),
}
ROLE_SUMMARIES = {
    "scout": "finding and summarising; read-only",
    "computational-engineer": "simulators, models, numerical code, pipelines",
    "mathematician": "equations, constants, units and valid ranges; specifies calculators",
    "designer": "layout and visual design on the design system",
    "frontend-developer": "interfaces built from the designer's mockups",
    "researcher": "literature, evidence and evidence tiers",
    "analyst": "data analysis and statistics",
    "science-writer": "papers and blog posts",
}
BLOCK_START, BLOCK_END = "<!-- scaffold:start -->", "<!-- scaffold:end -->"
#: The session hook every repo gets: at the start of a Claude Code session, it says whether a newer scaffold
#: exists (UPGRADING.md). Found through $SCAFFOLD_BIN, a `scaffold` on PATH, or a sibling checkout.
SETTINGS = Path(".claude") / "settings.json"
HOOK_MARK = "version --hook"
HOOK_CMD = ('S="${SCAFFOLD_BIN:-$(command -v scaffold || echo "$CLAUDE_PROJECT_DIR/../scientific-research-scaffold/bin/scaffold")}"; '
            '[ -f "$S" ] && python3 "$S" version --hook "$CLAUDE_PROJECT_DIR" || true')
SESSION_NOTE = ("- **Scaffold version.** At the start of a session, run `scaffold version .` (or "
                "`../scientific-research-scaffold/bin/scaffold version .`). If it reports a newer release, tell the "
                "person and offer to upgrade, following the steps it prints (Claude Code runs this by itself).")
#: Files the scaffold owns in a repo it made, which `update` may replace. Everything else belongs to the
#: repo. A sim inside a study owns none: it shares the study's.
OWNED = {
    kind: (".github/workflows/check.yml", "Makefile", *(("shared/workbench.py",) if kind == "study" else ()),
           ".claude/disciplines.md", *(f".claude/agents/{a}.md" for a in agents))
    for kind, agents in AGENTS.items()
}
STAGES = ("SKETCH", "PROBE", "BENCH", "SHIPPED")
APP_STATUSES = ("active", "superseded", "abandoned")

HYPOTHESIS_IMPACT_MANAGEMENT = ("agent-managed", "person-managed")
#: Work types that live as folders in a study and are registered in STUDY.toml (PROTOCOL.md, "Work types").
UNITS = {"dataset": "datasets", "calculator": "calculators"}
VISIBILITIES = ("public", "private")
SEMVER_RE = re.compile(r"^\d+\.\d+\.\d+$")
#: What makes a repo research. A tool holds none of it (PROTOCOL.md § 8).
RESEARCH_FILES = ("RESEARCH.md", "EXPERIMENTS.md", "experiments", "preregistrations")
#: A tool repo's comparison units (the prereg kit's TOOL_VERSIONING.md §1a): sims and dataset analyses that
#: compare the tool's functionality against other tools, as an extension of its test suite.
TOOL_COMPARISONS = {"sim": "sims", "dataset": "datasets"}
UNDECIDED = "undecided"
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]*[a-z0-9]$")
#: Kind prefixes the protocol retires (PROTOCOL.md § 1). The kind belongs in the manifest.
KIND_PREFIXES = ("lab-", "sim-", "study-", "case-", "exp-")
BRANCH_REFS = ("", "main", "master", "HEAD", "develop", "dev", "trunk")
KIND_LINE_RE = re.compile(r"\*\*Kind:\*\*\s*(study|sim|tool|workbench)\b(?:.*?\*\*Stage:\*\*\s*([A-Z]+))?")
ABS_PATH_RE = re.compile(r"(?<![\w.])(/Users/[A-Za-z0-9_.-]+/|/home/[a-z0-9_.-]+/)")
#: Tracked files that are records, not instructions: an absolute path in them is history, not a bug.
ABS_PATH_SKIP = re.compile(r"(\.jsonl$|provenance\.json$|(^|/)conversations/|(^|/)protocol/history/|^\.agents/|\.lock$)")
TEXT_SUFFIXES = {".py", ".md", ".toml", ".json", ".yaml", ".yml", ".sh", ".js", ".mjs", ".ts", ".html",
                 ".css", ".txt", ".cfg", ".ini", ".plist", ".cff", ""}


class Fail(Exception):
    """An expected failure: printed as one line, exit status 1."""


# ------------------------------------------------------------------------------------------ TOML

def load_toml(path):
    return parse_toml(Path(path).read_text(encoding="utf-8"), path)


def parse_toml(text, where):
    try:
        import tomllib  # Python 3.11+
        return tomllib.loads(text)
    except ImportError:
        return _mini_toml(text, where)


def _mini_toml(text, path):
    """The TOML subset manifests and profiles use: tables, arrays of tables, strings, numbers,
    booleans and flat arrays, which may span lines. Used only where tomllib is unavailable (Python < 3.11)."""
    root, cur = {}, None
    cur = root
    pending = None  # (key, parts, first line number) while a multi-line array is open
    for n, raw in enumerate(text.splitlines(), 1):
        line = _strip_comment(raw).strip()
        if pending:
            pending[1].append(line)
            joined = " ".join(pending[1])
            if _depth(joined) == 0:
                cur[pending[0]] = _value(joined, path, pending[2])
                pending = None
            continue
        if not line:
            continue
        if line.startswith("[["):
            name = line.strip("[] ")
            cur = {}
            _table(root, name[:name.rfind(".")] if "." in name else "").setdefault(name.split(".")[-1], []).append(cur)
        elif line.startswith("["):
            cur = _table(root, line.strip("[] "))
        elif "=" in line:
            k, v = line.split("=", 1)
            k, v = k.strip().strip('"'), v.strip()
            if k in cur:
                raise Fail(f"{path}:{n}: duplicate key {k!r}")
            if v.startswith("[") and _depth(v) > 0:
                pending = (k, [v], n)
            else:
                cur[k] = _value(v, path, n)
        else:
            raise Fail(f"{path}:{n}: cannot parse {raw!r}")
    if pending:
        raise Fail(f"{path}:{pending[2]}: array for {pending[0]!r} is never closed")
    return root


def _depth(s):
    """Open brackets minus closed ones, outside strings."""
    d, q = 0, None
    for ch in s:
        if q:
            q = None if ch == q else q
        elif ch in "\"'":
            q = ch
        elif ch == "[":
            d += 1
        elif ch == "]":
            d -= 1
    return d


def _table(root, dotted):
    t = root
    for part in [p for p in dotted.split(".") if p]:
        nxt = t.setdefault(part, {})
        t = nxt[-1] if isinstance(nxt, list) else nxt
    return t


def _strip_comment(s):
    out, q = [], None
    for ch in s:
        if q:
            out.append(ch)
            if ch == q:
                q = None
        elif ch in "\"'":
            q = ch
            out.append(ch)
        elif ch == "#":
            break
        else:
            out.append(ch)
    return "".join(out)


def _value(v, path, n):
    if v.startswith(("\"", "'")):
        return json.loads(v) if v[0] == '"' else v[1:-1]  # TOML basic-string escapes are JSON's
    if v in ("true", "false"):
        return v == "true"
    if v.startswith("["):
        inner = v[1:v.rfind("]")].strip()
        return [_value(x.strip(), path, n) for x in _split_array(inner)] if inner else []
    try:
        return float(v) if "." in v else int(v)
    except ValueError:
        raise Fail(f"{path}:{n}: unsupported value {v!r}") from None


def _split_array(s):
    parts, cur, q = [], [], None
    for ch in s:
        if q:
            cur.append(ch)
            q = None if ch == q else q
        elif ch in "\"'":
            q = ch
            cur.append(ch)
        elif ch == ",":
            parts.append("".join(cur))
            cur = []
        else:
            cur.append(ch)
    if "".join(cur).strip():
        parts.append("".join(cur))
    return parts


def toml_str(s):
    return json.dumps(s, ensure_ascii=False)


# ------------------------------------------------------------------------------------- helpers

def git(*args, cwd):
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    return r.returncode, r.stdout.strip(), r.stderr.strip()


def load_profile(name):
    p = PROFILES / f"{name}.toml"
    if not p.exists():
        have = ", ".join(sorted(x.stem for x in PROFILES.glob("*.toml")))
        raise Fail(f"no profile {name!r} in {PROFILES} (have: {have})")
    return load_toml(p)


def profile_name(explicit=None, manifest=None):
    """The profile to use: the manifest's, then --profile, then $SCAFFOLD_PROFILE. Never a built-in default."""
    name = (manifest or {}).get("profile") or explicit or os.environ.get("SCAFFOLD_PROFILE")
    if not name:
        have = ", ".join(sorted(x.stem for x in PROFILES.glob("*.toml")))
        raise Fail(f"no profile: pass --profile NAME or set SCAFFOLD_PROFILE (have: {have}). "
                   f"To make your own, copy profiles/example.toml")
    return name


def check_name(name):
    if not NAME_RE.match(name):
        raise Fail(f"{name!r}: use lowercase letters, digits and hyphens")
    for p in KIND_PREFIXES:
        if name.startswith(p):
            raise Fail(f"{name!r}: no kind prefix ({p}); the kind goes in the manifest (PROTOCOL.md § 1)")


def repo_basename(repo):
    return repo.rsplit("/", 1)[-1] if repo else ""


def template_vars(profile, name, question, **extra):
    wb = profile.get("workbench", {})
    ds = profile.get("design", {})
    v = {
        "name": name,
        "question": question.replace('"', "'"),
        "date": _dt.date.today().isoformat(),
        "year": str(_dt.date.today().year),
        "profile": profile.get("name", ""),
        "org": profile.get("org", ""),
        "author": profile.get("author", ""),
        "corpus_repo": profile.get("corpus", {}).get("repo", ""),
        "corpus_projects_dir": profile.get("corpus", {}).get("projects_dir", "projects"),
        "workbench_repo": wb.get("repo", ""),
        "workbench_name": repo_basename(wb.get("repo", "")),
        "workbench_marker": wb.get("marker", ""),
        "workbench_aliases": "".join(f"{json.dumps(a)}, " for a in wb.get("env_aliases", [])),
        "design_repo": ds.get("repo", ""),
        "design_name": repo_basename(ds.get("repo", "")),
        "design_css": ds.get("css", "design.css"),
        "design_js_tag": f'<script type="module" src="design/{ds["js"]}"></script>' if ds.get("js") else "",
        "scaffold_ref": SCAFFOLD_REF,
        "agents_ref": agents_ref(),
        "design_system": f"`{ds['repo']}`" if ds.get("repo") else
                         "not named in this repo's profile: ask the user which one to use before designing",
        "conventions": "\n".join(f"- {c}" for c in profile.get("agents", {}).get("conventions", [])) or
                       "- None are named in the profile: follow this repo's existing configuration and code.",
        "disciplines": discipline_briefs(profile.get("agents", {}).get("disciplines", [])),
    }
    v.update(extra)
    return v


def agents_ref():
    try:
        return "v" + (AGENTS_DIR / "VERSION").read_text(encoding="utf-8").strip()
    except OSError:
        raise Fail(f"{AGENTS_DIR} is empty: run `git submodule update --init` in {HERE}") from None


def discipline_briefs(names):
    if not names:
        return "None are named in this repo's profile. Ask the user which disciplines a task involves."
    briefs = []
    for n in names:
        f = AGENTS_DIR / "disciplines" / f"{n}.md"
        if not f.exists():
            have = ", ".join(sorted(x.stem for x in (AGENTS_DIR / "disciplines").glob("*.md")))
            raise Fail(f"no discipline brief {n!r} in agents/disciplines/ (have: {have})")
        briefs.append(f.read_text(encoding="utf-8").strip())
    return "\n\n".join(briefs)


def template_path(kind, rel):
    """Where the template for a file the scaffold owns lives: the kind's own, or scientific-research-agents'."""
    if rel.startswith(".claude/agents/"):
        return AGENTS_DIR / "agents" / Path(rel).name
    if rel == ".claude/disciplines.md":
        return AGENTS_DIR / "templates" / "disciplines.md"
    return TEMPLATES / kind / rel


def agent_vars(variables, rel, profile):
    """An agent file's variables: the repo's, plus its starting model and effort."""
    m = re.fullmatch(r"\.claude/agents/([\w-]+)\.md", rel)
    if not m:
        return variables
    model, effort = ROUTING.get(m.group(1), ("inherit", "medium"))
    override = str(profile.get("agents", {}).get("routing", {}).get(m.group(1), ""))
    if override:
        model, _, e = override.partition(":")
        effort = e or effort
    return {**variables, "model": model, "effort": effort}


def render_owned(kind, rel, variables, profile):
    return fill(template_path(kind, rel).read_text(encoding="utf-8"), agent_vars(variables, rel, profile), rel)


def render_agents(dest, kind, variables, profile):
    for rel in OWNED[kind]:
        if rel.startswith(".claude/"):
            out = dest / rel
            out.parent.mkdir(parents=True, exist_ok=True)
            out.write_text(render_owned(kind, rel, variables, profile), encoding="utf-8")


def retrieval_rule(profile):
    """The rule that sends research questions to the profile's retrieval tool, or nothing if it names none."""
    tool = profile.get("retrieval", {})
    if not tool.get("server"):
        return ""
    where = f" ([{tool['repo']}](https://github.com/{tool['repo']}))" if tool.get("repo") else ""
    return (f"- **Search with the retrieval tool first.** A question about science, the literature or evidence is "
            f"answered from `{tool['server']}`{where}, the MCP server of that name in the session: search with it "
            "before answering, and ground what you say in the passages it returns, not in memory or a general web "
            "search. If its tools aren't available in the session, say so before answering any other way. The "
            "person can tell you not to use it, for one question or a whole session. A question about this repo's "
            "own code or files doesn't need it.\n")


def agents_block(kind, variables, profile):
    """The scaffold's section of AGENTS.md: the roles and the coordination rules, for every assistant."""
    roster = "\n".join(f"| `{a}` | {ROLE_SUMMARIES[a]} | `.claude/agents/{a}.md` |" for a in AGENTS[kind])
    codex = profile.get("agents", {}).get("codex", {})
    models = (f"use `{codex['default_model']}`" if codex.get("default_model") else "use the configured default model") + \
        (f", and `{codex['escalation_model']}` when escalating" if codex.get("escalation_model") else "")
    body = fill((AGENTS_DIR / "templates" / "AGENTS.block.md").read_text(encoding="utf-8"), {
        **variables,
        "repo_rules": fill((AGENT_RULES / f"{kind}.md").read_text(encoding="utf-8"), variables,
                           f"agent-rules/{kind}.md").rstrip("\n") + "\n" + retrieval_rule(profile),
        "agent_roster": "| role | takes | brief |\n|---|---|---|\n" + roster,
        "codex_routing": f"{models}. Use low reasoning effort for finding and summarising, medium by default, "
                         f"and a higher effort supported by the selected model when escalating.",
    }, "AGENTS.block.md")
    return f"{BLOCK_START}\n{body.rstrip()}\n{SESSION_NOTE}\n{BLOCK_END}\n"


def with_block(text, block):
    """`text` with the scaffold's section replaced, or appended if it has none. Nothing else changes."""
    if BLOCK_START in text and BLOCK_END in text:
        head, rest = text.split(BLOCK_START, 1)
        return head + block.rstrip("\n") + rest.split(BLOCK_END, 1)[1]
    return (text.rstrip("\n") + "\n\n" if text.strip() else "") + block


def with_session_hook(text):
    """.claude/settings.json text with the scaffold's session hook, replacing an older one of its own and
    leaving every other hook (the prereg kit's among them) as it is."""
    cur = json.loads(text) if text.strip() else {}
    hooks = cur.setdefault("hooks", {})
    groups = []
    for group in hooks.get("SessionStart", []):
        kept = [h for h in group.get("hooks", []) if HOOK_MARK not in h.get("command", "")]
        if kept:
            groups.append({**group, "hooks": kept})
    groups.append({"hooks": [{"type": "command", "command": HOOK_CMD, "timeout": 10}]})
    hooks["SessionStart"] = groups
    return json.dumps(cur, indent=2) + "\n"


def write_session_hook(dest):
    path = dest / SETTINGS
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(with_session_hook(path.read_text(encoding="utf-8") if path.exists() else ""), encoding="utf-8")


def write_agents_block(dest, kind, variables, profile):
    path = dest / "AGENTS.md"
    cur = path.read_text(encoding="utf-8") if path.exists() else ""
    path.write_text(with_block(cur, agents_block(kind, variables, profile)), encoding="utf-8")


def render(src, dest, variables, skip=()):
    """Copy a template tree, filling {{placeholders}}. An unknown placeholder is an error."""
    for f in sorted(src.rglob("*")):
        rel = f.relative_to(src)
        if f.is_dir() or any(str(rel).startswith(s) for s in skip):
            continue
        out = dest / rel
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(fill(f.read_text(encoding="utf-8"), variables, rel), encoding="utf-8")
        if os.access(f, os.X_OK):
            out.chmod(0o755)


def fill(text, variables, where):
    """Fill {{placeholders}} in one template's text. An unknown placeholder is an error."""
    def sub(m):
        k = m.group(1)
        if k not in variables:
            raise Fail(f"template {where}: unknown placeholder {{{{{k}}}}}")
        return variables[k]
    return re.sub(r"\{\{(\w+)\}\}", sub, text)


def sha256(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def owned_files(kind, profile):
    return [f for f in OWNED[kind] if f != "shared/workbench.py" or profile.get("workbench", {}).get("repo")]


def write_lock(root, kind, profile, only=None, adopted=False):
    """Record what the scaffold wrote, so `update` can tell a file nobody touched from one somebody edited.

    `adopted` marks a repo that took up the scaffold rather than being made by it: `update` never adds a
    missing file to it unasked, however many times it runs."""
    files = {f: sha256((root / f).read_text(encoding="utf-8"))
             for f in owned_files(kind, profile) if (root / f).exists() and (only is None or f in only)}
    lock = {"scaffold": SCAFFOLD_REF, **({"adopted": True} if adopted else {}), "files": files}
    (root / LOCK).write_text(json.dumps(lock, indent=2) + "\n", encoding="utf-8")


def write_licence(dest, profile):
    lic = profile.get("licence", {})
    code, docs = lic.get("code", "MIT"), lic.get("docs", "CC-BY-4.0")
    year, author = _dt.date.today().year, profile.get("author", "")
    (dest / "LICENSES").mkdir(exist_ok=True)
    for spdx in {code, docs}:
        src = HERE / "LICENSES" / f"{spdx}.txt"
        if src.exists():
            shutil.copy(src, dest / "LICENSES" / src.name)
    (dest / "LICENSE").write_text(
        f"This repository is released under two licences.\n\n"
        f"Code: {code} (LICENSES/{code}.txt)\n"
        f"Text, figures and documentation: {docs} (LICENSES/{docs}.txt)\n\n"
        f"Copyright (c) {year} {author}\n\n"
        f"Third-party data keeps its own licence, recorded with each dataset in datasets/.\n", encoding="utf-8")


def find_kit_ap(explicit, profile):
    for c in (explicit, os.environ.get("KIT_AP")):
        if c:
            p = Path(c).expanduser()
            p = p / "bin" / "kit_ap" if p.is_dir() else p
            if not p.exists():
                raise Fail(f"kit_ap not found at {p}")
            return p
    name = repo_basename(profile.get("prereg", {}).get("repo", ""))
    for sib in (HERE.parent / name, HERE.parent / f"kit-{name}"):
        if (sib / "bin" / "kit_ap").exists():
            return sib / "bin" / "kit_ap"
    return None


def install_kit(dest, profile, kit_ap, extra=None):
    extra = profile.get("prereg", {}).get("modules", []) if extra is None else extra
    if not kit_ap:
        repo = profile.get("prereg", {}).get("repo", "")
        print(f"  ! prereg kit not installed: kit_ap not found. Run:\n"
              f"      git clone https://github.com/{repo}.git\n"
              f"      <that clone>/bin/kit_ap init {dest}" +
              (f"\n      {dest}/.agents/bin/kit_ap add {' '.join(extra)}" if extra else ""))
        return False
    for args in (["init", str(dest)], *([["add", *extra, "--repo", str(dest)]] if extra else [])):
        r = subprocess.run([sys.executable, str(kit_ap), *args], capture_output=True, text=True)
        if r.returncode:
            # `add` takes the repo differently across kit versions; retry from inside the repo.
            if args[0] == "add":
                r = subprocess.run([sys.executable, str(dest / ".agents" / "bin" / "kit_ap"), "add", *extra],
                                   cwd=dest, capture_output=True, text=True)
            if r.returncode:
                print(f"  ! kit_ap {args[0]} failed: {(r.stderr or r.stdout).strip().splitlines()[-1:]}")
                return False
    print(f"  prereg kit installed ({', '.join(['defaults', *extra])})")
    return True


EXPLORATORY_LABEL = ("**Scope:** exploratory. No claim yet, and nothing here is a finding. It gets its claim before "
                     "its first preregistered experiment.")
EXPLORATORY_DOCS = ("README.md", "CALCULATOR.md")


def write_exploratory(dest, unit, building):
    """Mark a unit the person called exploratory: the scope record the preregistration kit reads (its
    SCOPE_PROTOCOL.md, format 3) with the build note in place of a claim, and the label where it is read."""
    (dest / "SCOPE.toml").write_text(
        "# Scope record (.agents/protocols/SCOPE_PROTOCOL.md). Exploratory: no claim yet, and features need no\n"
        "# evidence basis or decision. Settle the claim, and set stage = \"testing\", before the first experiment.\n\n"
        f"format = 3\nunit = {toml_str(unit)}\nstage = \"exploratory\"\n\n"
        f"[exploration]\nbuilding = {toml_str(building)}\nknown = \"\"\n"
        f"started = \"{_dt.date.today().isoformat()}\"\n\n"
        "[claim]\ntext = \"\"\ncounts_against = \"\"\ndecided = \"\"\nexperiments = []\n", encoding="utf-8")
    doc = next((dest / n for n in EXPLORATORY_DOCS if (dest / n).exists()), None)
    if doc is None:
        (dest / "README.md").write_text(f"# {unit}\n\n{EXPLORATORY_LABEL}\n", encoding="utf-8")
        return
    lines = doc.read_text(encoding="utf-8").splitlines()
    at = next((i + 1 for i, ln in enumerate(lines) if ln.startswith("# ")), 0)
    lines[at:at] = ["", EXPLORATORY_LABEL]
    doc.write_text("\n".join(lines) + "\n", encoding="utf-8")


def append_toml(path, block):
    text = path.read_text(encoding="utf-8").rstrip("\n")
    path.write_text(text + "\n\n" + block.strip("\n") + "\n", encoding="utf-8")


def hypothesis_fingerprints(element):
    """Short deterministic snapshots: scientific meaning separately from its corpus evidence set."""
    meaning = {k: element.get(k) for k in
               ("kind", "statement", "status", "basis", "depends_on", "derivation", "goal", "counts_against",
                "acceptance", "accepted_revision", "accepted")}
    evidence = {k: element.get(k) for k in ("evidence", "evidence_revision")}
    digest = lambda value: hashlib.sha256(json.dumps(value, sort_keys=True, ensure_ascii=False).encode()).hexdigest()[:16]
    return digest(meaning), digest(evidence)


def hypothesis_unit_block(study, unit_path, element_ids, role=""):
    """Prevalidate a unit link; return its graph block and testing-scope text before any writes."""
    path = Path(study) / "HYPOTHESIS.toml"
    if not path.exists():
        raise Fail(f"{path} is missing; add the study hypothesis map before creating units")
    h = load_toml(path)
    elements = {str(e.get("id")): e for e in h.get("elements", [])}
    unknown = [eid for eid in element_ids if eid not in elements]
    if unknown:
        raise Fail("unknown hypothesis element(s): " + ", ".join(unknown))
    unaccepted = [eid for eid in element_ids
                  if elements[eid].get("acceptance") != "accepted" or
                  elements[eid].get("accepted_revision") != elements[eid].get("revision")]
    if unaccepted:
        raise Fail("hypothesis element(s) not accepted by the person at their current revision: "
                   + ", ".join(unaccepted))
    revisions = [f"{eid}@{elements[eid].get('revision', 1)}" for eid in element_ids]
    evidence_revisions = [f"{eid}@{elements[eid].get('evidence_revision', 'unverified')}" for eid in element_ids]
    fingerprints = [f"{eid}@{hypothesis_fingerprints(elements[eid])[0]}" for eid in element_ids]
    evidence_fingerprints = [f"{eid}@{hypothesis_fingerprints(elements[eid])[1]}" for eid in element_ids]
    accepted_revisions = [f"{eid}@{elements[eid].get('accepted_revision')}" for eid in element_ids]
    state = "current" if element_ids else "unmapped"
    scope_element = element_ids[0] if element_ids else ""
    block = ("[[units]]\n"
            f"path = {toml_str(str(unit_path))}\n"
            f"elements = {toml_str(list(element_ids))}\n"
            f"scope_element = {toml_str(scope_element)}\n"
            f"role = {toml_str(role)}\n"
            f"element_revisions = {toml_str(revisions)}\n"
            f"accepted_revisions = {toml_str(accepted_revisions)}\n"
            f"evidence_revisions = {toml_str(evidence_revisions)}\n"
            f"element_fingerprints = {toml_str(fingerprints)}\n"
            f"evidence_fingerprints = {toml_str(evidence_fingerprints)}\n"
            f"corpus_revision = {toml_str(h.get('corpus_revision', 'unverified'))}\n"
            f"state = {toml_str(state)}\n"
            'disposition = ""\n'
            "disposition_for_element_revisions = []\n"
            "disposition_for_accepted_revisions = []\n"
            "disposition_for_evidence_revisions = []\n"
            "disposition_for_element_fingerprints = []\n"
            "disposition_for_evidence_fingerprints = []\n"
            'disposition_for_corpus_revision = ""')
    scope = ""
    if scope_element:
        e = elements[scope_element]
        manifest = load_toml(Path(study) / "STUDY.toml")
        scope = (
            "# Scope record (.agents/protocols/SCOPE_PROTOCOL.md), derived from the accepted study hypothesis.\n"
            "format = 3\n"
            f"unit = {toml_str(Path(unit_path).name)}\n"
            'stage = "testing"\n'
            f"corpus_project = {toml_str(manifest.get('corpus', {}).get('project', ''))}\n"
            f"hypothesis_elements = {toml_str(list(element_ids))}\n"
            f"hypothesis_scope_element = {toml_str(scope_element)}\n"
            f"hypothesis_revisions = {toml_str(revisions)}\n"
            f"hypothesis_accepted_revisions = {toml_str(accepted_revisions)}\n"
            f"hypothesis_fingerprints = {toml_str(fingerprints)}\n\n"
            'hypothesis_review_state = "current"\n\n'
            "[exploration]\n"
            'building = ""\nknown = ""\nstarted = ""\n\n'
            "[claim]\n"
            f"text = {toml_str(str(e.get('statement', '')))}\n"
            f"counts_against = {toml_str(str(e.get('counts_against', '')))}\n"
            f"decided = {toml_str(str(e.get('accepted', '')))}\n"
            "experiments = []\n")
    return block, scope


def register_hypothesis_unit(study, block):
    append_toml(Path(study) / "HYPOTHESIS.toml", block)


def _array_table_matches(text, table):
    """Return complete top-level [[table]] blocks without rewriting surrounding comments."""
    return list(re.finditer(
        rf"(?ms)^\[\[{re.escape(table)}\]\]\n.*?(?=^\[\[[A-Za-z0-9_.-]+\]\]|\Z)", text))


def _replace_assignments(block, values):
    """Replace or append scalar/flat-array assignments in one array-table block."""
    lines = block.rstrip("\n").splitlines()
    present = set()
    for i, line in enumerate(lines):
        m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)\s*=", line)
        if m and m.group(1) in values:
            key = m.group(1)
            lines[i] = f"{key} = {toml_str(values[key])}"
            present.add(key)
    for key, value in values.items():
        if key not in present:
            lines.append(f"{key} = {toml_str(value)}")
    return "\n".join(lines) + "\n"


def _replace_unit_block(path, unit_path, replacement=None, values=None):
    text = path.read_text(encoding="utf-8")
    for match in _array_table_matches(text, "units"):
        block = match.group(0)
        parsed = load_toml_text(block, path).get("units", [{}])[0]
        if str(parsed.get("path", "")) != unit_path:
            continue
        new = replacement if replacement is not None else _replace_assignments(block, values or {})
        path.write_text(text[:match.start()] + new + text[match.end():], encoding="utf-8")
        return
    raise Fail(f"{path}: no [[units]] record for {unit_path}")


def load_toml_text(text, where="<text>"):
    try:
        import tomllib  # Python 3.11+
        return tomllib.loads(text)
    except ImportError:
        return _mini_toml(text, where)


def _hypothesis_snapshot(elements, element_ids):
    by_id = {str(e.get("id")): e for e in elements}
    revisions = [f"{eid}@{by_id[eid].get('revision')}" for eid in element_ids]
    accepted = [f"{eid}@{by_id[eid].get('accepted_revision')}" for eid in element_ids]
    evidence = [f"{eid}@{by_id[eid].get('evidence_revision')}" for eid in element_ids]
    meaning_fp = [f"{eid}@{hypothesis_fingerprints(by_id[eid])[0]}" for eid in element_ids]
    evidence_fp = [f"{eid}@{hypothesis_fingerprints(by_id[eid])[1]}" for eid in element_ids]
    return revisions, accepted, evidence, meaning_fp, evidence_fp


def _render_hypothesis_unit(unit_path, element_ids, scope_element, role, elements, corpus_revision):
    revisions, accepted, evidence, meaning_fp, evidence_fp = _hypothesis_snapshot(elements, element_ids)
    return (
        "[[units]]\n"
        f"path = {toml_str(unit_path)}\n"
        f"elements = {toml_str(element_ids)}\n"
        f"scope_element = {toml_str(scope_element)}\n"
        f"role = {toml_str(role)}\n"
        f"element_revisions = {toml_str(revisions)}\n"
        f"accepted_revisions = {toml_str(accepted)}\n"
        f"evidence_revisions = {toml_str(evidence)}\n"
        f"element_fingerprints = {toml_str(meaning_fp)}\n"
        f"evidence_fingerprints = {toml_str(evidence_fp)}\n"
        f"corpus_revision = {toml_str(corpus_revision)}\n"
        'state = "current"\n'
        'disposition = ""\n'
        "disposition_for_element_revisions = []\n"
        "disposition_for_accepted_revisions = []\n"
        "disposition_for_evidence_revisions = []\n"
        "disposition_for_element_fingerprints = []\n"
        "disposition_for_evidence_fingerprints = []\n"
        'disposition_for_corpus_revision = ""\n')


def _set_scope_hypothesis(scope_path, element_ids, scope_element, snapshot, review_state):
    """Keep dependency provenance beside a unit for every stage without changing its claim."""
    text = scope_path.read_text(encoding="utf-8")
    keys = {
        "hypothesis_elements": element_ids,
        "hypothesis_scope_element": scope_element,
        "hypothesis_revisions": snapshot[0],
        "hypothesis_accepted_revisions": snapshot[1],
        "hypothesis_fingerprints": snapshot[3],
        "hypothesis_review_state": review_state,
    }
    lines = text.splitlines()
    first_table = next((i for i, line in enumerate(lines) if re.match(r"^\[[^[]", line.strip())), len(lines))
    head, tail = lines[:first_table], lines[first_table:]
    names = set(keys)
    head = [line for line in head if not (re.match(r"^([A-Za-z_][A-Za-z0-9_]*)\s*=", line) and
                                         re.match(r"^([A-Za-z_][A-Za-z0-9_]*)", line).group(1) in names)]
    while head and not head[-1].strip():
        head.pop()
    head.extend(["", *(f"{key} = {toml_str(value)}" for key, value in keys.items()), ""])
    scope_path.write_text("\n".join([*head, *tail]).rstrip() + "\n", encoding="utf-8")


def cmd_link_hypothesis(a):
    """Record an agent-reviewed unit association and take its initial auditable snapshot."""
    root = Path(a.path).resolve()
    hypothesis_path = root / "HYPOTHESIS.toml"
    if not hypothesis_path.exists():
        raise Fail(f"{root} has no HYPOTHESIS.toml")
    h = load_toml(hypothesis_path)
    elements = h.get("elements", [])
    by_id = {str(e.get("id")): e for e in elements}
    element_ids = list(dict.fromkeys(a.element))
    if not element_ids:
        raise Fail("link-hypothesis needs at least one --element")
    missing = [eid for eid in element_ids if eid not in by_id]
    if missing:
        raise Fail(f"unknown hypothesis element(s): {', '.join(missing)}")
    unsettled = [eid for eid in element_ids if by_id[eid].get("acceptance") != "accepted" or
                 by_id[eid].get("accepted_revision") != by_id[eid].get("revision")]
    if unsettled:
        raise Fail(f"hypothesis element(s) not accepted at their current revision: {', '.join(unsettled)}")
    scope_element = a.scope_element or element_ids[0]
    if scope_element not in element_ids:
        raise Fail("--scope-element must also be named by --element")
    role = a.role.strip()
    if not role:
        raise Fail("link-hypothesis needs --role so the unit's purpose is visible in the map")
    scope_path = root / a.unit / "SCOPE.toml"
    if not scope_path.exists():
        raise Fail(f"{a.unit} has no SCOPE.toml; scope the unit before linking it")
    block = _render_hypothesis_unit(a.unit, element_ids, scope_element, role, elements,
                                    str(h.get("corpus_revision", "unverified")))
    _replace_unit_block(hypothesis_path, a.unit, replacement=block)
    _set_scope_hypothesis(scope_path, element_ids, scope_element,
                          _hypothesis_snapshot(elements, element_ids), "current")
    print(f"linked {a.unit} -> {', '.join(element_ids)} (scope {scope_element})")


def _sync_hypothesis_one(a):
    """Mechanically flag stale mappings; never silently accept a changed scientific meaning."""
    root = Path(a.path).resolve()
    hypothesis_path = root / "HYPOTHESIS.toml"
    h = load_toml(hypothesis_path)
    elements = h.get("elements", [])
    by_id = {str(e.get("id")): e for e in elements}
    corpus_revision = str(h.get("corpus_revision", ""))
    changed = []
    for unit in h.get("units", []):
        unit_path = str(unit.get("path", ""))
        ids = [str(x) for x in unit.get("elements", [])]
        if not ids or any(eid not in by_id for eid in ids):
            continue
        expected = _hypothesis_snapshot(elements, ids)
        stale = (unit.get("element_revisions", []) != expected[0] or
                 unit.get("accepted_revisions", []) != expected[1] or
                 unit.get("evidence_revisions", []) != expected[2] or
                 unit.get("element_fingerprints", []) != expected[3] or
                 unit.get("evidence_fingerprints", []) != expected[4] or
                 unit.get("corpus_revision") != corpus_revision)
        state = "needs-review" if stale else "current"
        disposition_is_current = bool(unit.get("disposition")) and (
            unit.get("disposition_for_element_revisions", []) == expected[0] and
            unit.get("disposition_for_accepted_revisions", []) == expected[1] and
            unit.get("disposition_for_evidence_revisions", []) == expected[2] and
            unit.get("disposition_for_element_fingerprints", []) == expected[3] and
            unit.get("disposition_for_evidence_fingerprints", []) == expected[4] and
            unit.get("disposition_for_corpus_revision") == corpus_revision)
        if stale and (unit.get("state") != state or (unit.get("disposition") and not disposition_is_current)):
            _replace_unit_block(hypothesis_path, unit_path, values={
                "state": state,
                "disposition": "",
                "disposition_for_element_revisions": [],
                "disposition_for_accepted_revisions": [],
                "disposition_for_evidence_revisions": [],
                "disposition_for_element_fingerprints": [],
                "disposition_for_evidence_fingerprints": [],
                "disposition_for_corpus_revision": "",
            })
            changed.append(unit_path)
        scope_path = root / unit_path / "SCOPE.toml"
        if scope_path.exists():
            snapshot = (unit.get("element_revisions", []), unit.get("accepted_revisions", []),
                        unit.get("evidence_revisions", []), unit.get("element_fingerprints", []),
                        unit.get("evidence_fingerprints", []))
            _set_scope_hypothesis(scope_path, ids, str(unit.get("scope_element", "")), snapshot, state)
    if changed:
        print("flagged for agent review: " + ", ".join(changed))
    else:
        print("hypothesis links are synchronized; no new impacts")


def cmd_sync_hypothesis(a):
    """Synchronize one or many affected studies selected through the corpus reverse index."""
    paths = a.paths or ["."]
    for raw in paths:
        if len(paths) > 1:
            print(f"{Path(raw).resolve()}:")
        _sync_hypothesis_one(argparse.Namespace(path=raw))


# ------------------------------------------------------------------------------------------ new

def cmd_new(a):
    if a.kind in TOOL_COMPARISONS:
        where = getattr(a, "inside", None) if a.kind == "sim" else a.study
        tool = Path(where).resolve() if where else None
        if tool is not None and (tool / "TOOL.toml").exists():
            if not a.question:
                raise Fail(f"a {a.kind} needs --question")
            check_name(a.name)
            return new_comparison(a, tool)
    if getattr(a, "compares", None):
        raise Fail("--compares is for a sim or dataset inside a tool repo (a comparison unit)")
    if a.kind in ("app", *UNITS):
        if not a.question:
            raise Fail(f"a {a.kind} needs --question")
        return new_app(a) if a.kind == "app" else new_unit(a)
    check_name(a.name)
    if a.exploratory and a.kind in CONTAINERS:
        raise Fail(f"a {a.kind} starts with its question; --exploratory is for a unit (an app, sim, tool, dataset "
                   "or calculator)")
    inside = Path(a.inside).resolve() if getattr(a, "inside", None) else None
    host = container(inside) if inside else None  # (kind, manifest path) of what --inside points at
    if inside:
        if a.kind == "workbench":
            raise Fail("a workbench is always its own repo")
        if a.kind == "study" and host[0] != "workbench":
            raise Fail("a study goes --inside a workbench, or is its own repo")
    if a.kind == "tool":
        if not a.job or a.question:
            raise Fail("a tool has a --job (what it does for other repos), not a --question: it holds no research")
    elif not a.question:
        raise Fail(f"a {a.kind} needs --question")
    if a.kind == "study" and not a.hypothesis:
        raise Fail("a study needs --hypothesis in the person's own words; the scaffold does not substitute its question")
    if a.hypothesis and a.kind != "study":
        raise Fail("--hypothesis is only for a study")
    if inside and a.visibility:
        raise Fail(f"--visibility is for a repo; a {a.kind} inside a {host[0]} shares its visibility")
    if inside:
        folder = {"study": "studies", "sim": "sims", "tool": "tools"}[a.kind]
        profile = load_profile(profile_name(a.profile, load_toml(host[1])))
        dest = inside / folder / a.name
    else:
        profile = load_profile(profile_name(a.profile))
        dest = Path(a.dir).resolve() / a.name
    if dest.exists() and any(dest.iterdir()):
        raise Fail(f"{dest} already exists and is not empty")
    hypothesis_link, hypothesis_scope = None, ""
    if inside and host[0] == "study" and a.kind == "sim":
        hypothesis_link, hypothesis_scope = hypothesis_unit_block(
            inside, f"sims/{a.name}", a.hypothesis_element or [], a.question or "")
    v = template_vars(profile, a.name, a.question or a.job, visibility=a.visibility or UNDECIDED,
                      visibility_decided=_dt.date.today().isoformat() if a.visibility else "")
    v["hypothesis_toml"] = toml_str(a.hypothesis or "")
    v["job"] = v["question"]
    skip = ()
    if a.kind == "study" and not profile.get("workbench", {}).get("repo"):
        skip = ("shared/workbench.py",)
    if inside:  # it shares the repo-level files of what it is inside: CI, licence, the kit, the agents
        skip = (".github", "Makefile", "CITATION.cff", "pyproject.toml", ".gitignore", "CLAUDE.md", "CHANGELOG.md",
                "EXPERIMENTS.md", "shared", "TOOL.toml")
    if inside and a.kind == "tool":  # a tool inside a study or workbench is a unit, not a tool repo
        v["slug"] = a.name
        render(TEMPLATES / "units" / "tool", dest, v)
    else:
        render(TEMPLATES / a.kind, dest, v, skip=skip)
    if not inside:
        render_agents(dest, a.kind, v, profile)
    if hypothesis_scope and not a.exploratory:
        (dest / "SCOPE.toml").write_text(hypothesis_scope, encoding="utf-8")
    if a.exploratory:
        write_exploratory(dest, a.name, a.question or a.job)
    print(f"created {a.kind} {dest}" + (" (exploratory: no claim yet)" if a.exploratory else ""))

    if inside:
        manifest = dest / f"{a.kind.upper()}.toml"
        if manifest.exists():  # what it is inside decides visibility; the unit doesn't carry its own
            kept = [ln for ln in manifest.read_text(encoding="utf-8").splitlines() if not ln.startswith("visibility")]
            manifest.write_text("\n".join(kept) + "\n", encoding="utf-8")
        append_toml(host[1], f'[[{folder}]]\nslug = {toml_str(a.name)}\npath = {toml_str(f"{folder}/{a.name}")}')
        if hypothesis_link:
            register_hypothesis_unit(inside, hypothesis_link)
        print(f"  registered in {host[1]}")
        return
    write_licence(dest, profile)
    write_lock(dest, a.kind, profile)
    if a.no_git:
        write_agents_block(dest, a.kind, v, profile)
        write_session_hook(dest)
        return
    git("init", "-q", "-b", "main", cwd=dest)
    git("add", "-A", cwd=dest)
    code, _, err = git("commit", "-q", "-m", f"Scaffold {a.kind} {a.name} (scientific-research-scaffold)", cwd=dest)
    if code:
        print(f"  ! initial commit failed: {err}")
    # A tool preregisters nothing: it takes the profile's tool modules (tool-versioning) instead of its
    # preregistration modules. The kit's defaults include prereg, which scopes the tool claim first.
    tool_modules = profile.get("prereg", {}).get("tool_modules", [])
    install_kit(dest, profile, find_kit_ap(a.kit_ap, profile), extra=tool_modules if a.kind == "tool" else None)
    write_agents_block(dest, a.kind, v, profile)
    write_session_hook(dest)
    git("add", "AGENTS.md", str(SETTINGS), cwd=dest)
    git("commit", "-q", "-m", "Add the agents section and the scaffold session hook (scientific-research-scaffold)", cwd=dest)
    org = profile.get("org", "<org>")
    manifest = f"{a.kind.upper()}.toml"
    if a.visibility:
        print(f"\nNext: gh repo create {org}/{a.name} --{a.visibility} --source {dest} --push")
    else:
        print(f"\nNext: decide visibility, and record it in {manifest} (`scaffold check` fails until you do):\n"
              f'      visibility = "public" or "private"\n'
              f'      visibility_decided = "{_dt.date.today().isoformat()}"\n'
              f"then  gh repo create {org}/{a.name} --<public|private> --source {dest} --push")


def container(path):
    """(kind, manifest path) of the study or workbench at `path`."""
    for kind in CONTAINERS:
        manifest = Path(path) / f"{kind.upper()}.toml"
        if manifest.exists():
            return kind, manifest
    raise Fail(f"{path} has no STUDY.toml or WORKBENCH.toml")


def app_path(root, app):
    """Where an app version is: its `path`, else apps/<slug>/<version>, else the earlier apps/<version>-<slug>
    when that is the folder that exists."""
    if app.get("path"):
        return app["path"]
    ver, slug = str(app.get("version", "")), str(app.get("slug", ""))
    earlier = f"apps/{ver}-{slug}"
    return earlier if (root / earlier).is_dir() and not (root / "apps" / slug / ver).is_dir() else f"apps/{slug}/{ver}"


def new_app(a):
    study = Path(a.study).resolve()
    _, manifest_path = container(study)
    check_name(a.name)
    m = load_toml(manifest_path)
    profile = load_profile(profile_name(a.profile, m))
    apps = m.get("apps", [])
    # Each app has its own versions, numbered from v1: apps/<slug>/v1, apps/<slug>/v2.
    nums = [int(x["version"][1:]) for x in apps
            if x.get("slug") == a.name and re.fullmatch(r"v\d+", str(x.get("version", "")))]
    version = f"v{max(nums, default=0) + 1}"
    dest = study / "apps" / a.name / version
    if dest.exists():
        raise Fail(f"{dest} already exists")
    hypothesis_link, hypothesis_scope = hypothesis_unit_block(
        study, dest.relative_to(study).as_posix(), a.hypothesis_element or [], a.question or "")
    port = str(8300 + (sum(map(ord, m.get("name", ""))) % 50) * 10 + len(apps) % 10)
    v = template_vars(profile, m.get("name", study.name), a.question, title=f"{a.name} ({version})",
                      version=version, port=port)
    render(TEMPLATES / "app", dest, v)
    (dest / "serve.py").chmod(0o755)
    if hypothesis_scope and not a.exploratory:
        (dest / "SCOPE.toml").write_text(hypothesis_scope, encoding="utf-8")
    if a.exploratory:
        write_exploratory(dest, f"{a.name}/{version}", a.question)
    append_toml(manifest_path,
                f"[[apps]]\nversion = {toml_str(version)}\nslug = {toml_str(a.name)}\n"
                f"question = {toml_str(a.question)}\nstatus = \"active\"")
    register_hypothesis_unit(study, hypothesis_link)
    print(f"created app {dest}\n  run: python3 {dest.relative_to(study)}/serve.py")


def new_unit(a):
    """A dataset or calculator folder in a study, registered in STUDY.toml."""
    study = Path(a.study).resolve()
    _, manifest_path = container(study)
    check_name(a.name)
    m = load_toml(manifest_path)
    folder = UNITS[a.kind]
    dest = study / folder / a.name
    if dest.exists():
        raise Fail(f"{dest} already exists")
    hypothesis_link, hypothesis_scope = hypothesis_unit_block(
        study, f"{folder}/{a.name}", a.hypothesis_element or [], a.question or "")
    profile = load_profile(profile_name(a.profile, m))
    v = template_vars(profile, m.get("name", study.name), a.question, slug=a.name)
    render(TEMPLATES / "units" / a.kind, dest, v)
    if hypothesis_scope and not a.exploratory:
        (dest / "SCOPE.toml").write_text(hypothesis_scope, encoding="utf-8")
    if a.exploratory:
        write_exploratory(dest, a.name, a.question)
    append_toml(manifest_path, f"[[{folder}]]\nslug = {toml_str(a.name)}\npath = {toml_str(f'{folder}/{a.name}')}")
    register_hypothesis_unit(study, hypothesis_link)
    print(f"created {a.kind} {dest}\n  registered in {manifest_path}")


# -------------------------------------------------------------------------------- promote-sim

def cmd_promote(a):
    sim = Path(a.path).resolve()
    if not (sim / "SIM.toml").exists():
        raise Fail(f"{sim} has no SIM.toml")
    code, top, _ = git("rev-parse", "--show-toplevel", cwd=sim)
    if code:
        raise Fail(f"{sim} is not in a git repo")
    top = Path(top)
    prefix = sim.relative_to(top).as_posix()
    name = load_toml(sim / "SIM.toml").get("name", sim.name)
    branch = f"promote/{name}"
    print(f"splitting {prefix} into branch {branch} (keeps its history)...")
    code, out, err = git("subtree", "split", f"--prefix={prefix}", "-b", branch, cwd=top)
    if code:
        raise Fail(f"git subtree split failed: {err}")
    dest = Path(a.dir).resolve() / name
    if dest.exists():
        raise Fail(f"{dest} already exists")
    code, _, err = git("clone", "-q", "--branch", branch, str(top), str(dest), cwd=top)
    if code:
        raise Fail(f"clone failed: {err}")
    git("checkout", "-q", "-b", "main", cwd=dest)
    git("remote", "remove", "origin", cwd=dest)
    m = load_toml(sim / "SIM.toml")
    pname = m.get("profile") or os.environ.get("SCAFFOLD_PROFILE")
    org = load_profile(pname).get("org", "<org>") if pname else "<org>"
    print(f"""
promoted to {dest}, with history. Remaining, in order (PROTOCOL.md § 7):
  1. In {dest}: add the repo-level files a standalone sim owes (LICENSE, CLAUDE.md, CITATION.cff,
     pyproject.toml, CI); `scaffold check {dest}` lists what is missing. Install the prereg kit.
  2. Decide visibility and record it in SIM.toml (visibility, visibility_decided), then:
         gh repo create {org}/{name} --<public|private> --source {dest} --push
  3. Tag the current model:    git -C {dest} tag -a model-v0.1.0 -m "promoted from {top.name}"
  4. In {top.name}: delete {prefix}, and replace its [[sims]] entry with
         repo = "{org}/{name}"
         ref = "model-v0.1.0"
     then pin it in pyproject.toml. The branch {branch} can be deleted once pushed.""")


# -------------------------------------------------------------------------------------- check

class Report:
    def __init__(self, root):
        self.root, self.fails, self.warns, self.oks = root, [], [], 0

    def ok(self, cond, msg, warn=False):
        if cond:
            self.oks += 1
        elif warn:
            self.warns.append(msg)
        else:
            self.fails.append(msg)
        return cond


def check_repo(root, rep, nested=False, profile_override=None):
    root = Path(root).resolve()
    manifests = [k for k in KINDS if (root / f"{k.upper()}.toml").exists()]
    if not rep.ok(len(manifests) == 1,
                  f"{root.name}: exactly one of STUDY.toml / SIM.toml / TOOL.toml / WORKBENCH.toml is required"):
        return
    kind = manifests[0]
    try:
        m = load_toml(root / f"{kind.upper()}.toml")
    except Exception as e:  # noqa: BLE001 - report any parse error as a failure
        rep.ok(False, f"{kind.upper()}.toml does not parse: {e}")
        return
    where = "" if not nested else f"{root.name}: "
    rep.ok(m.get("kind") == kind, f"{where}{kind.upper()}.toml says kind = {m.get('kind')!r}")
    name = m.get("name", "")
    try:
        check_name(name)
        rep.ok(True, "")
    except Fail as e:
        rep.ok(False, f"{where}name: {e}")
    rep.ok(name == root.name, f"{where}name {name!r} differs from the folder name {root.name!r}", warn=True)
    if kind == "tool":
        rep.ok(bool(m.get("job")), "TOOL.toml has no job (what the tool does for the repos that use it)")
    else:
        rep.ok(bool(m.get("question")), f"{where}manifest has no question")
    if kind != "workbench":  # a workbench has no one stage: each study and unit in it has its own
        rep.ok(m.get("stage") in STAGES, f"{where}stage {m.get('stage')!r} is not one of {', '.join(STAGES)}")

    readme = root / "README.md"
    if rep.ok(readme.exists(), f"{where}README.md is missing"):
        head = readme.read_text(encoding="utf-8").splitlines()[:12]
        km = next((KIND_LINE_RE.search(line) for line in head if KIND_LINE_RE.search(line)), None)
        if rep.ok(km is not None, f"{where}README.md has no '**Kind:** {kind} · **Stage:** ...' line near the top"):
            rep.ok(km.group(1) == kind, f"{where}README kind {km.group(1)!r} disagrees with the manifest ({kind!r})")
            if km.group(2):
                rep.ok(km.group(2) == m.get("stage"),
                       f"{where}README stage {km.group(2)} disagrees with the manifest ({m.get('stage')})")

    profile = {}
    pname = profile_override or m.get("profile")
    if pname:
        try:
            profile = load_profile(pname)
        except Fail as e:
            rep.ok(False, str(e), warn=True)

    if kind == "sim":
        model = m.get("model", "model")
        rep.ok((root / model).exists(), f"{where}model path {model!r} does not exist (set model = in SIM.toml)")
    if kind == "study":
        check_hypothesis(root, rep, where, profile)
    if nested and kind != "study":
        return

    if not nested:
        vis = m.get("visibility")
        rep.ok(vis in VISIBILITIES,
               f"visibility is undecided: decide it, then set visibility = 'public' or 'private' in {kind.upper()}.toml"
               if vis in (None, "", UNDECIDED) else f"visibility must be 'public' or 'private', not {vis!r}")
        rep.ok(bool(re.fullmatch(r"\d{4}-\d{2}-\d{2}", str(m.get("visibility_decided", "")))),
               "visibility_decided must be the date (YYYY-MM-DD) visibility was decided")
        required = ("CLAUDE.md", "AGENTS.md") if kind == "workbench" else ("CLAUDE.md", "AGENTS.md", "LICENSE") + (
            ("CHANGELOG.md", "CITATION.cff") if kind == "tool" else ("EXPERIMENTS.md", "RESEARCH.md"))
        for f in required:
            rep.ok((root / f).exists(), f"{f} is missing")
        if kind == "tool":
            check_tool(root, m, rep)
        else:
            lock = root / ".agents" / "kit_ap.lock"
            if rep.ok(lock.exists(), "prereg kit not installed (.agents/kit_ap.lock missing): run kit_ap init"):
                try:
                    mods = json.loads(lock.read_text()).get("modules", [])
                except ValueError:
                    mods = []
                rep.ok("prereg" in mods, "kit_ap.lock does not include the prereg module")
            if kind != "workbench":  # a workbench's studies each name their own corpus project
                corpus = m.get("corpus", {}).get("project", "")
                rep.ok(bool(corpus), "no corpus project named in the manifest ([corpus] project = ...)",
                       warn=(kind == "sim"))
        gm = root / ".gitmodules"
        corpus_repo = profile.get("corpus", {}).get("repo", "")
        if gm.exists() and corpus_repo and kind != "workbench":  # a workbench may mount the corpus; nothing else does
            rep.ok(corpus_repo.lower() not in gm.read_text().lower(),
                   f"the corpus ({corpus_repo}) is a submodule; reference it by claim ID instead")
        for rel in m.get("private", []):
            rep.ok((root / rel).exists(), f"private folder {rel!r} does not exist")
        rep.ok(not m.get("private") or vis == "private",
               "this repo lists private folders, so visibility must be 'private'")

    for t in m.get("tools", []) if kind in ("study", "sim", "workbench") else []:
        slug = t.get("slug", "?")
        if "path" in t:  # a tool that lives here, in this study or workbench
            rep.ok((root / t["path"]).is_dir(), f"{where}tool {slug}: {t['path']} does not exist")
        else:
            ref = str(t.get("ref", ""))
            rep.ok(bool(t.get("repo")), f"{where}tool {slug}: no repo")
            rep.ok(ref not in BRANCH_REFS and bool(re.search(r"\d", ref)),
                   f"{where}tool {slug}: must be pinned to a tag or commit, not {ref!r}")
    if kind == "workbench":
        listed = set()
        for st in m.get("studies", []):
            slug = st.get("slug", "?")
            sp = root / st.get("path", f"studies/{slug}")
            listed.add(sp.resolve())
            if rep.ok((sp / "STUDY.toml").exists(), f"study {slug}: {sp.relative_to(root)}/STUDY.toml is missing"):
                check_repo(sp, rep, nested=True, profile_override=pname)
        for d in sorted(x for x in (root / "studies").glob("*") if x.is_dir()):
            rep.ok(d.resolve() in listed, f"studies/{d.name} is not registered in WORKBENCH.toml under [[studies]]",
                   warn=True)

    if kind in CONTAINERS:
        for app in m.get("apps", []):
            ver, slug = str(app.get("version", "")), app.get("slug", "")
            label = f"app {slug}/{ver}"
            rep.ok(bool(re.fullmatch(r"v\d+", ver)), f"{label}: version must look like v1, v2, ...")
            rep.ok(app.get("status", "active") in APP_STATUSES, f"{label}: status must be one of {APP_STATUSES}")
            path = root / app_path(root, app)
            if rep.ok(path.exists(), f"{label}: {path.relative_to(root)} does not exist"):
                rep.ok(any(path.glob("index.html")) or any(path.glob("*/index.html")),
                       f"{label}: no index.html in {path.relative_to(root)}", warn=True)
        for d in m.get("datasets", []):
            if not adopted_unit(root, d, "datasets", "DATASET.toml", where, rep):
                check_dataset(root, d, rep)
        for c in m.get("calculators", []):
            if not adopted_unit(root, c, "calculators", "CALCULATOR.md", where, rep):
                check_calculator(root, c, m.get("stage"), rep)
        for folder in UNITS.values():
            listed = {u.get("path", f"{folder}/{u.get('slug')}") for u in m.get(folder, [])}
            for d in sorted(p for p in (root / folder).glob("*") if p.is_dir()):
                rep.ok(d.relative_to(root).as_posix() in listed,
                       f"{where}{d.relative_to(root)} is not registered in {kind.upper()}.toml under [[{folder}]]",
                       warn=True)
        rep.ok(nested or kind == "workbench" or not (root / "experiments").is_dir(),
               "experiments/ is the old layout: preregistrations now live in the unit they test "
               "(<unit>/preregistrations/<EID>/); existing ones stay, listed in EXPERIMENTS.md (UPGRADING.md)", warn=True)
        rep.ok(not (root / "data" / "manifest.json").exists(),
               "data/manifest.json is the old layout: each dataset now has datasets/<slug>/DATASET.toml", warn=True)
        for s in m.get("sims", []):
            slug = s.get("slug", "?")
            if "repo" in s:
                ref = str(s.get("ref", ""))
                rep.ok(ref not in BRANCH_REFS and bool(re.search(r"\d", ref)),
                       f"sim {slug}: external sim must be pinned to a tag or commit, not {ref!r}")
            else:
                p = root / s.get("path", f"sims/{slug}")
                if rep.ok(p.exists(), f"sim {slug}: {p.relative_to(root)} does not exist"):
                    if (p / "SIM.toml").exists():
                        check_repo(p, rep, nested=True, profile_override=pname)
                    else:
                        rep.ok(False, f"sim {slug}: {p.relative_to(root)} has no SIM.toml yet", warn=True)
    if nested:
        return

    check_exploratory(root, rep)
    code, out, _ = git("ls-files", cwd=root)
    hits = []
    if not code:
        for rel in out.splitlines():
            p = root / rel
            if ABS_PATH_SKIP.search(rel) or p.suffix not in TEXT_SUFFIXES or not p.is_file():
                continue
            try:
                if p.stat().st_size > 2_000_000:
                    continue
                for i, line in enumerate(p.read_text(encoding="utf-8").splitlines(), 1):
                    if ABS_PATH_RE.search(line) and "Managed by KIT" not in line:
                        hits.append(f"{rel}:{i}")
            except (UnicodeDecodeError, OSError):
                continue
    rep.ok(not hits, f"{len(hits)} absolute home-directory path(s): " + ", ".join(hits[:5])
           + (" ..." if len(hits) > 5 else ""), warn=True)


def valid_research_revision(value):
    return value in ("unverified", "unresolved", "unassessed") or bool(
        re.fullmatch(r"(?:[0-9a-f]{7,40}|v?\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?)", value))


def research_mentions(text, ref):
    """Exact Markdown token/cell match, avoiding substring matches between evidence IDs."""
    edge = r"[\s|`,;()\[\]]"
    return bool(re.search(rf"(?:^|{edge}){re.escape(ref)}(?:$|{edge})", text, re.M))


def check_hypothesis(root, rep, where="", profile=None):
    """Check the study-level map from the person's hypothesis to evidence-backed or falsifiable elements."""
    path = root / "HYPOTHESIS.toml"
    if not rep.ok(path.exists(), f"{where}HYPOTHESIS.toml is missing"):
        return
    try:
        h = load_toml(path)
    except Exception as e:  # noqa: BLE001 - report any parse error as a failure
        rep.ok(False, f"{where}HYPOTHESIS.toml does not parse: {e}")
        return
    rep.ok(h.get("format") == 1, f"{where}HYPOTHESIS.toml format must be 1")
    rep.ok(bool(str(h.get("hypothesis", "")).strip()), f"{where}HYPOTHESIS.toml has no hypothesis")
    study = load_toml(root / "STUDY.toml")
    stage = study.get("stage")
    corpus_revision = str(h.get("corpus_revision", ""))
    impact_management = str(h.get("impact_management", "person-managed"))
    rep.ok(impact_management in HYPOTHESIS_IMPACT_MANAGEMENT,
           f"{where}HYPOTHESIS.toml impact_management must be one of {HYPOTHESIS_IMPACT_MANAGEMENT}")
    if "impact_management" not in h:
        rep.ok(False, f"{where}HYPOTHESIS.toml has no impact-management policy; defaulting to person-managed",
               warn=(stage == "SKETCH"))
    rep.ok(impact_management != "agent-managed" or
           bool(re.fullmatch(r"\d{4}-\d{2}-\d{2}", str(h.get("impact_management_decided", "")))),
           f"{where}agent-managed impact handling needs impact_management_decided (YYYY-MM-DD)")
    rep.ok(valid_research_revision(corpus_revision),
           f"{where}HYPOTHESIS.toml corpus_revision must be a commit/tag or an unresolved sentinel")
    rep.ok(corpus_revision not in ("unverified", "unresolved", "unassessed"),
           f"{where}HYPOTHESIS.toml corpus evidence has not been reconciled to a revision",
           warn=(stage == "SKETCH"))
    corpus_repo = (profile or {}).get("corpus", {}).get("repo", "")
    corpus_checkout = root.parent / repo_basename(corpus_repo)
    if corpus_repo and (corpus_checkout / ".git").exists() and corpus_revision not in (
            "unverified", "unresolved", "unassessed"):
        code, resolved, _ = git("rev-parse", f"{corpus_revision}^{{commit}}", cwd=corpus_checkout)
        code_head, head, _ = git("rev-parse", "HEAD", cwd=corpus_checkout)
        rep.ok(not code and not code_head and resolved == head,
               f"{where}corpus checkout changed ({head[:12] if head else 'unknown'}); reconcile evidence and "
               "update corpus_revision", warn=(stage == "SKETCH"))
    elements = h.get("elements", [])
    if not rep.ok(bool(elements), f"{where}HYPOTHESIS.toml has no [[elements]]"):
        return
    ids = [str(e.get("id", "")) for e in elements]
    rep.ok(len(set(ids)) == len(ids), f"{where}HYPOTHESIS.toml element IDs are not unique")
    known = set(ids)
    research = (root / "RESEARCH.md").read_text(encoding="utf-8") if (root / "RESEARCH.md").exists() else ""
    for e in elements:
        eid = str(e.get("id", "?"))
        label = f"{where}hypothesis element {eid}"
        rep.ok(bool(re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]*", eid)),
               f"{label}: id must start with a letter and contain only letters, numbers, _ or -")
        kind = e.get("kind")
        status = e.get("status")
        basis = e.get("basis")
        revision = e.get("revision")
        acceptance = e.get("acceptance")
        accepted_revision = e.get("accepted_revision")
        rep.ok(kind in HYPOTHESIS_KINDS, f"{label}: kind must be one of {HYPOTHESIS_KINDS}")
        rep.ok(status in HYPOTHESIS_STATUSES, f"{label}: status must be one of {HYPOTHESIS_STATUSES}")
        rep.ok(basis in HYPOTHESIS_BASES, f"{label}: basis must be one of {HYPOTHESIS_BASES}")
        rep.ok(acceptance in HYPOTHESIS_ACCEPTANCE,
               f"{label}: acceptance must be one of {HYPOTHESIS_ACCEPTANCE}", warn=(stage == "SKETCH"))
        rep.ok(status != "established" or basis == "established",
               f"{label}: established status requires established basis")
        rep.ok(status != "exploratory" or basis == "exploratory",
               f"{label}: exploratory status requires exploratory basis")
        rep.ok(status != "open" or basis in ("supported", "derived", "gap"),
               f"{label}: open status requires supported, derived or gap basis")
        rep.ok(isinstance(revision, int) and revision >= 1, f"{label}: revision must be an integer >= 1")
        accepted_now = acceptance == "accepted" and accepted_revision == revision
        rep.ok(acceptance != "accepted" or accepted_revision == revision,
               f"{label}: accepted_revision must equal revision after the person's acceptance")
        rep.ok(acceptance != "accepted" or bool(re.fullmatch(r"\d{4}-\d{2}-\d{2}", str(e.get("accepted", "")))),
               f"{label}: accepted must record the person's acceptance date (YYYY-MM-DD)")
        rep.ok(accepted_now, f"{label}: proposed or changed revision still needs the person's acceptance",
               warn=(stage == "SKETCH"))
        evidence_revision = str(e.get("evidence_revision", ""))
        rep.ok(bool(evidence_revision.strip()), f"{label}: evidence_revision is empty")
        rep.ok(bool(str(e.get("statement", "")).strip()), f"{label}: statement is empty")
        deps = e.get("depends_on", [])
        rep.ok(isinstance(deps, list), f"{label}: depends_on must be an array")
        if isinstance(deps, list):
            rep.ok(eid not in deps, f"{label}: cannot depend on itself")
            missing = [d for d in deps if d not in known]
            rep.ok(not missing, f"{label}: unknown depends_on IDs: {', '.join(map(str, missing))}")
            if kind == "integration":
                rep.ok(len(deps) >= 2, f"{label}: an integration must connect at least two element IDs")
        evidence = e.get("evidence", [])
        rep.ok(isinstance(evidence, list), f"{label}: evidence must be an array")
        if basis in ("established", "supported", "derived"):
            rep.ok(bool(evidence), f"{label}: {basis} requires verified corpus evidence IDs",
                   warn=(not accepted_now and stage == "SKETCH"))
            rep.ok(valid_research_revision(evidence_revision) and evidence_revision not in
                   ("unverified", "unresolved", "unassessed"),
                   f"{label}: {basis} requires a verified evidence_revision",
                   warn=(not accepted_now and stage == "SKETCH"))
        if basis == "derived":
            rep.ok(bool(str(e.get("derivation", "")).strip()), f"{label}: derived basis requires a derivation")
        if status != "established":
            rep.ok(bool(str(e.get("goal", "")).strip()), f"{label}: {status} requires a goal",
                   warn=(not accepted_now and stage == "SKETCH"))
            rep.ok(bool(str(e.get("counts_against", "")).strip()),
                   f"{label}: {status} requires what would count against it",
                   warn=(not accepted_now and stage == "SKETCH"))
        if isinstance(evidence, list):
            unlinked = [str(ref) for ref in evidence if not str(ref).strip() or
                        not research_mentions(research, str(ref))]
            rep.ok(not unlinked, f"{label}: evidence IDs must also be referenced in RESEARCH.md: "
                   + ", ".join(unlinked))

    expected = set()
    aliases = {}
    for app in study.get("apps", []):
        actual = app_path(root, app)
        expected.add(actual)
        ver, slug = str(app.get("version", "")), str(app.get("slug", ""))
        aliases[f"apps/{slug}/{ver}"] = actual
        aliases[f"apps/{ver}-{slug}"] = actual
    for sim in study.get("sims", []):
        expected.add(f"repo:{sim.get('repo')}@{sim.get('ref')}" if sim.get("repo") else
                     sim.get("path", f"sims/{sim.get('slug')}"))
    for folder in ("datasets", "calculators"):
        for unit in study.get(folder, []):
            expected.add(unit.get("path", f"{folder}/{unit.get('slug')}"))
    mappings = h.get("units", [])
    mapped_paths = [aliases.get(str(u.get("path", "")), str(u.get("path", ""))) for u in mappings]
    rep.ok(len(mapped_paths) == len(set(mapped_paths)), f"{where}HYPOTHESIS.toml unit paths are not unique")
    by_path = {aliases.get(str(u.get("path", "")), str(u.get("path", ""))): u for u in mappings}
    missing_units = sorted(expected - set(mapped_paths))
    extra_units = sorted(set(mapped_paths) - expected)
    # SKETCH migration may expose unresolved legacy units without inventing links. By PROBE every unit is linked.
    rep.ok(not missing_units, f"{where}units missing from HYPOTHESIS.toml: {', '.join(missing_units)}",
           warn=(stage == "SKETCH"))
    rep.ok(not extra_units, f"{where}HYPOTHESIS.toml maps unknown units: {', '.join(extra_units)}")
    for unit_path in sorted(expected & set(mapped_paths)):
        u = by_path[unit_path]
        label = f"{where}hypothesis unit {unit_path}"
        state = u.get("state")
        disposition = str(u.get("disposition", ""))
        linked = [str(x) for x in u.get("elements", [])]
        scope_element = str(u.get("scope_element", ""))
        role = str(u.get("role", ""))
        rep.ok(state in HYPOTHESIS_UNIT_STATES, f"{label}: state must be one of {HYPOTHESIS_UNIT_STATES}")
        unknown = [eid for eid in linked if eid not in known]
        rep.ok(not unknown, f"{label}: unknown element IDs: {', '.join(unknown)}")
        if not linked or state == "unmapped":
            rep.ok(False, f"{label}: unmapped; settle its hypothesis element links without inventing them",
                   warn=(stage == "SKETCH"))
            continue
        unaccepted = [eid for eid in linked if eid in known and (
            next(e for e in elements if str(e.get("id")) == eid).get("acceptance") != "accepted" or
            next(e for e in elements if str(e.get("id")) == eid).get("accepted_revision") !=
            next(e for e in elements if str(e.get("id")) == eid).get("revision"))]
        rep.ok(not unaccepted, f"{label}: cannot derive scope from proposed/unaccepted elements: "
               + ", ".join(unaccepted))
        rep.ok(scope_element in linked, f"{label}: scope_element must name one linked element")
        rep.ok(bool(role.strip()), f"{label}: role must say how the unit bears on its linked elements",
               warn=(stage == "SKETCH"))
        expected_element_revs = [f"{eid}@{next(e for e in elements if str(e.get('id')) == eid).get('revision')}"
                                 for eid in linked if eid in known]
        expected_accepted_revs = [
            f"{eid}@{next(e for e in elements if str(e.get('id')) == eid).get('accepted_revision')}"
            for eid in linked if eid in known]
        expected_evidence_revs = [
            f"{eid}@{next(e for e in elements if str(e.get('id')) == eid).get('evidence_revision')}"
            for eid in linked if eid in known]
        expected_fingerprints = [
            f"{eid}@{hypothesis_fingerprints(next(e for e in elements if str(e.get('id')) == eid))[0]}"
            for eid in linked if eid in known]
        expected_evidence_fingerprints = [
            f"{eid}@{hypothesis_fingerprints(next(e for e in elements if str(e.get('id')) == eid))[1]}"
            for eid in linked if eid in known]
        stale = u.get("element_revisions", []) != expected_element_revs or \
            u.get("accepted_revisions", []) != expected_accepted_revs or \
            u.get("evidence_revisions", []) != expected_evidence_revs or \
            u.get("element_fingerprints", []) != expected_fingerprints or \
            u.get("evidence_fingerprints", []) != expected_evidence_fingerprints or \
            u.get("corpus_revision") != corpus_revision
        if stale:
            rep.ok(state == "needs-review", f"{label}: hypothesis/evidence changed; state must be 'needs-review'")
            if disposition:
                rep.ok(disposition in HYPOTHESIS_DISPOSITIONS,
                       f"{label}: disposition must be one of: {', '.join(HYPOTHESIS_DISPOSITIONS)}")
                rep.ok(u.get("disposition_for_element_revisions", []) == expected_element_revs and
                       u.get("disposition_for_accepted_revisions", []) == expected_accepted_revs and
                       u.get("disposition_for_evidence_revisions", []) == expected_evidence_revs and
                       u.get("disposition_for_element_fingerprints", []) == expected_fingerprints and
                       u.get("disposition_for_evidence_fingerprints", []) == expected_evidence_fingerprints and
                       u.get("disposition_for_corpus_revision") == corpus_revision,
                       f"{label}: disposition must be bound to the exact current revision and fingerprints")
            elif impact_management == "agent-managed":
                rep.ok(False, f"{label}: queued for agent review; run sync-hypothesis after relevant changes",
                       warn=True)
            else:
                rep.ok(False, f"{label}: stale link requires disposition: {', '.join(HYPOTHESIS_DISPOSITIONS)}")
        else:
            rep.ok(state == "current", f"{label}: snapshots match; state must be 'current'")
            rep.ok(not disposition, f"{label}: current link must have an empty disposition")
            rep.ok(not any((u.get("disposition_for_element_revisions", []),
                            u.get("disposition_for_accepted_revisions", []),
                            u.get("disposition_for_evidence_revisions", []),
                            u.get("disposition_for_element_fingerprints", []),
                            u.get("disposition_for_evidence_fingerprints", []),
                            u.get("disposition_for_corpus_revision", ""))),
                   f"{label}: current link must not retain stale disposition bindings")
        if not unit_path.startswith("repo:"):
            scope_path = root / unit_path / "SCOPE.toml"
            if rep.ok(scope_path.exists(), f"{label}: mapped local unit has no SCOPE.toml",
                      warn=(stage == "SKETCH")):
                try:
                    scope = load_toml(scope_path)
                except Exception as e:  # noqa: BLE001
                    rep.ok(False, f"{label}: SCOPE.toml does not parse: {e}")
                    scope = {}
                rep.ok(scope.get("hypothesis_elements", []) == linked,
                       f"{label}: SCOPE.toml hypothesis_elements do not match the graph")
                rep.ok(scope.get("hypothesis_scope_element") == scope_element,
                       f"{label}: SCOPE.toml hypothesis_scope_element does not match the graph")
                rep.ok(scope.get("hypothesis_revisions", []) == u.get("element_revisions", []),
                       f"{label}: SCOPE.toml revisions do not match the unit snapshot")
                rep.ok(scope.get("hypothesis_accepted_revisions", []) == u.get("accepted_revisions", []),
                       f"{label}: SCOPE.toml accepted revisions do not match the unit snapshot")
                rep.ok(scope.get("hypothesis_fingerprints", []) == u.get("element_fingerprints", []),
                       f"{label}: SCOPE.toml fingerprints do not match the unit snapshot")
                rep.ok(scope.get("hypothesis_review_state") == state,
                       f"{label}: SCOPE.toml review state does not match the graph")


def adopted_unit(root, entry, folder, manifest, where, rep):
    """A unit that predates this layout (`adopted = true`): it must exist, and it owes its manifest the next
    time it is worked on. Returns True when the entry is adopted, so the full check is skipped."""
    if not entry.get("adopted"):
        return False
    slug = entry.get("slug", "?")
    path = root / entry.get("path", f"{folder}/{slug}")
    if rep.ok(path.is_dir(), f"{where}{folder[:-1]} {slug}: {path.relative_to(root)} does not exist"):
        rep.ok((path / manifest).exists(),
               f"{where}{folder[:-1]} {slug}: adopted from an earlier layout; add its {manifest} when it is next worked on",
               warn=True)
    return True


def check_dataset(root, d, rep):
    """A dataset analysis: its reference pinned to a version, with a licence, once it is selected."""
    slug = d.get("slug", "?")
    path = root / d.get("path", f"datasets/{slug}")
    if not rep.ok((path / "DATASET.toml").exists(), f"dataset {slug}: {path.relative_to(root)}/DATASET.toml is missing"):
        return
    try:
        ds = load_toml(path / "DATASET.toml")
    except Exception as e:  # noqa: BLE001 - reported, not fatal
        rep.ok(False, f"dataset {slug}: DATASET.toml does not parse: {e}")
        return
    status = ds.get("status")
    if not rep.ok(status in DATASET_STATUSES, f"dataset {slug}: status must be one of {', '.join(DATASET_STATUSES)}"):
        return
    if status != "candidate":
        for key in ("provider", "accession", "licence"):
            rep.ok(bool(ds.get(key)), f"dataset {slug}: a {status} dataset needs {key}")
        version = str(ds.get("version", ""))
        rep.ok(bool(version) and version.lower() not in ("latest", "main", "master", "head"),
               f"dataset {slug}: a {status} dataset is pinned to a version, not {version or 'nothing'}")
        rep.ok(bool(ds.get("selection", {}).get("criteria")),
               f"dataset {slug}: record the selection criteria before selecting it")


def check_calculator(root, c, stage, rep):
    """A calculator: its maths written down, and reference values its tests run."""
    slug = c.get("slug", "?")
    path = root / c.get("path", f"calculators/{slug}")
    if not rep.ok((path / "CALCULATOR.md").exists(), f"calculator {slug}: {path.relative_to(root)}/CALCULATOR.md is missing"):
        return
    ref = path / "reference.csv"
    rows = [r for r in ref.read_text(encoding="utf-8").splitlines()[1:] if r.strip()] if ref.exists() else []
    rep.ok(bool(rows), f"calculator {slug}: reference.csv has no reference values"
           + ("" if stage == "SKETCH" else " (required from PROBE on)"), warn=(stage == "SKETCH"))


def check_exploratory(root, rep):
    """A unit marked exploratory (SCOPE.toml, stage = "exploratory", format 3) says so where it is read, and has
    no preregistered experiments: an experiment tests a claim, and it has none yet."""
    code, out, _ = git("ls-files", "--cached", "--others", "--exclude-standard", "--", "SCOPE.toml", "*/SCOPE.toml",
                       cwd=root)
    found = out.splitlines() if not code else [p.relative_to(root).as_posix() for p in root.rglob("SCOPE.toml")
                                               if ".git" not in p.parts and ".agents" not in p.parts]
    for rel in sorted(found):
        if rel.startswith(".agents/"):
            continue
        try:
            rec = load_toml(root / rel)
        except Exception:  # noqa: BLE001 - the kit's scope-status reports a record that doesn't parse
            continue
        if rec.get("format") != 3 or rec.get("stage") != "exploratory":
            continue
        unit = (root / rel).parent
        name = "the repo" if unit == root else unit.relative_to(root).as_posix()
        said = any("exploratory" in (unit / n).read_text(encoding="utf-8").lower()
                   for n in EXPLORATORY_DOCS if (unit / n).is_file())
        rep.ok(said, f"{name}: SCOPE.toml says exploratory, but its README doesn't; nothing it shows is a finding")
        prereg = unit / "preregistrations"
        tested = sorted(d.name for d in prereg.iterdir() if d.is_dir()) if prereg.is_dir() else []
        rep.ok(not tested, f"{name}: exploratory, yet it has preregistered experiments ({', '.join(tested[:3])}); "
               "settle its claim and set stage = \"testing\" in SCOPE.toml")


def comparison_units(root):
    """A tool's comparison units: folders under sims/ or datasets/ with a SCOPE.toml or preregistrations/."""
    units = []
    for folder in TOOL_COMPARISONS.values():
        base = Path(root) / folder
        if base.is_dir():
            units += [f"{folder}/{d.name}" for d in sorted(base.iterdir())
                      if d.is_dir() and ((d / "SCOPE.toml").exists() or (d / "preregistrations").is_dir())]
    return units


def check_comparisons(root, m, units, rep):
    """TOOL_VERSIONING.md §1a: each comparison unit names what it compares, is listed in TOOL.toml, and holds
    its own preregistrations; no preregistrations anywhere else in the tool."""
    listed = [str(c.get("path", "")) for c in m.get("comparisons", [])]
    for unit in units:
        scope = root / unit / "SCOPE.toml"
        compares = []
        if rep.ok(scope.exists(), f"{unit}: a comparison unit needs a SCOPE.toml naming what it compares"):
            try:
                compares = load_toml(scope).get("compares", [])
            except Exception:  # noqa: BLE001 - reported as a missing list
                compares = []
            rep.ok(isinstance(compares, list) and len(compares) >= 2,
                   f"{unit}/SCOPE.toml: compares must name the tool and at least one other tool")
        rep.ok(unit in listed, f"{unit} is not listed under [[comparisons]] in TOOL.toml")
    for path in listed:
        rep.ok((root / path).is_dir(), f"TOOL.toml lists comparison {path!r}, which does not exist")
    skip = {".git", ".agents", "node_modules", ".venv", "venv", "__pycache__"}
    for dirpath, dirnames, _ in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in skip]
        if "preregistrations" in dirnames:
            rel = Path(dirpath).relative_to(root).as_posix()
            if rel != ".":
                rep.ok(rel in units, f"{rel}/preregistrations: a tool's preregistrations go directly inside a "
                       "comparison unit (sims/<slug>/ or datasets/<slug>/)")
            dirnames.remove("preregistrations")


def new_comparison(a, tool):
    """A sim or dataset analysis inside a tool repo that compares the tool against other tools
    (TOOL_VERSIONING.md §1a), registered under [[comparisons]] in TOOL.toml."""
    manifest = tool / "TOOL.toml"
    m = load_toml(manifest)
    if not a.compares:
        raise Fail("a comparison unit in a tool needs --compares for each other tool it is compared with "
                   "(e.g. --compares \"brian2 2.10.1\")")
    if a.hypothesis_element:
        raise Fail("--hypothesis-element is for a study; a tool holds no hypothesis map")
    folder = TOOL_COMPARISONS[a.kind]
    dest = tool / folder / a.name
    if dest.exists():
        raise Fail(f"{dest} already exists")
    profile = load_profile(profile_name(a.profile, m))
    v = template_vars(profile, a.name, a.question, slug=a.name, visibility=UNDECIDED, visibility_decided="")
    v["job"] = v["question"]
    if a.kind == "sim":
        render(TEMPLATES / "sim", dest, v, skip=(".github", "Makefile", "CITATION.cff", "pyproject.toml", ".gitignore",
                                                 "CLAUDE.md", "CHANGELOG.md", "EXPERIMENTS.md", "RESEARCH.md"))
        sim_manifest = dest / "SIM.toml"
        text = sim_manifest.read_text(encoding="utf-8").split("\n[corpus]")[0]  # its results stay in the tool
        kept = [ln for ln in text.splitlines() if not ln.startswith("visibility")]
        sim_manifest.write_text("\n".join(kept) + "\n# A comparison unit (TOOL_VERSIONING.md §1a): its results stay "
                                "here, not in the research corpus.\n", encoding="utf-8")
    else:
        render(TEMPLATES / "units" / "dataset", dest, v)
    this = f"{m.get('name', tool.name)} {m.get('version', '')}".strip()
    compares = [this] + list(a.compares)
    if a.exploratory:
        write_exploratory(dest, a.name, a.question)
    else:
        (dest / "SCOPE.toml").write_text(
            "# Scope record (.agents/protocols/SCOPE_PROTOCOL.md) of a comparison unit (TOOL_VERSIONING.md §1a).\n"
            "# Its claim is about the tools' outputs on declared inputs, never about the world.\n\n"
            f"format = 3\nunit = {toml_str(a.name)}\nstage = \"testing\"\n\n"
            "[claim]\ntext = \"\"\ncounts_against = \"\"\ndecided = \"\"\nexperiments = []\n", encoding="utf-8")
    scope = dest / "SCOPE.toml"
    text = scope.read_text(encoding="utf-8")
    at = text.index("\n\n[") + 1  # after the top-level keys, before the first table
    scope.write_text(text[:at] + "compares = [" + ", ".join(toml_str(c) for c in compares) + "]\n" + text[at:],
                     encoding="utf-8")
    experiments = tool / "EXPERIMENTS.md"
    if not experiments.exists():
        experiments.write_text(
            "# Experiments\n\nEvery preregistered experiment of this tool's comparison units (TOOL_VERSIONING.md "
            "§1a). They compare the tool's output with other tools; none is a claim about the world.\n\n"
            "| EID | Unit | Question (short) | Replaces | Opened | Status | Verdict | Archive (DOI) |\n"
            "|-----|------|------------------|----------|--------|--------|---------|---------------|\n",
            encoding="utf-8")
    append_toml(manifest, f"[[comparisons]]\nkind = {toml_str(a.kind)}\npath = {toml_str(f'{folder}/{a.name}')}\n"
                          f"compares = [{', '.join(toml_str(c) for c in compares)}]")
    print(f"created {a.kind} {dest} (a comparison unit of {this})"
          + (" (exploratory: no claim yet)" if a.exploratory else "") + f"\n  registered in {manifest}")


def check_tool(root, m, rep):
    """What makes a tool a tool: no research in it, one version said everywhere, consumers named."""
    try:
        mods = json.loads((root / ".agents" / "kit_ap.lock").read_text()).get("modules", [])
    except (OSError, ValueError):
        mods = []
    if (root / ".agents" / "protocols" / "SCOPE_PROTOCOL.md").exists() or "tool-scope" in mods:
        rep.ok((root / "SCOPE.toml").exists(), "unscoped: no SCOPE.toml yet; scope the tool with the person before "
               "building anything scientific (.agents/protocols/SCOPE_PROTOCOL.md)", warn=True)
    units = comparison_units(root)
    for f in RESEARCH_FILES:
        if f == "EXPERIMENTS.md" and units:
            continue  # it lists the comparison units' experiments
        rep.ok(not (root / f).exists(),
               f"{f} is research, and a tool holds none: it belongs to the study or sim that uses the tool"
               + (" (a comparison with other tools goes in sims/<slug>/ or datasets/<slug>/)"
                  if f in ("experiments", "preregistrations") else ""))
    check_comparisons(root, m, units, rep)
    for key in ("question", "corpus"):
        rep.ok(key not in m, f"TOOL.toml has {key!r}: a tool holds no research, so it has a job, not a question")

    version = str(m.get("version", ""))
    if rep.ok(bool(SEMVER_RE.match(version)), f"TOOL.toml version {version!r} must be X.Y.Z"):
        said = {}
        pyproject = root / "pyproject.toml"
        if pyproject.exists():
            # Only [project] version is needed, and a pyproject can use TOML the built-in parser does not cover.
            pv = re.search(r"^\[project\]\s*$(?:(?!^\[).)*?^version\s*=\s*[\"']([^\"']+)",
                           pyproject.read_text(encoding="utf-8"), re.M | re.S)
            if pv:
                said["pyproject.toml"] = pv.group(1)
        cff = root / "CITATION.cff"
        if cff.exists():
            cv = re.search(r"^version:\s*[\"']?([^\s\"']+)", cff.read_text(encoding="utf-8"), re.M)
            if cv:
                said["CITATION.cff"] = cv.group(1)
        for where, v in said.items():
            rep.ok(v == version, f"{where} says version {v}, TOOL.toml says {version}")
        changelog = root / "CHANGELOG.md"
        if version != "0.0.0" and changelog.exists():
            heading = re.compile(rf"^#+ .*\bv?{re.escape(version)}\b", re.M)
            rep.ok(bool(heading.search(changelog.read_text(encoding="utf-8"))),
                   f"CHANGELOG.md has no heading for version {version}")

    for c in m.get("consumers", []):
        label = f"consumer {c.get('name', '?')}"
        rep.ok(bool(c.get("name")) and bool(c.get("repo")), f"{label}: needs a name and a repo")
        rep.ok(bool(c.get("uses")), f"{label}: list what it relies on under uses, so a change to it is caught")


def cmd_check(a):
    root = Path(a.path).resolve()
    rep = Report(root)
    check_repo(root, rep)
    for w in rep.warns:
        print(f"  warn  {w}")
    for f in rep.fails:
        print(f"  FAIL  {f}")
    print(f"{root.name}: {rep.oks} ok, {len(rep.warns)} warning(s), {len(rep.fails)} failure(s)")
    return 1 if rep.fails else 0


def cmd_profiles(_a):
    for p in sorted(PROFILES.glob("*.toml")):
        prof = load_toml(p)
        print(f"{p.stem:16} corpus={prof.get('corpus', {}).get('repo', '-')}  "
              f"design={prof.get('design', {}).get('repo') or '-'}  workbench={prof.get('workbench', {}).get('repo') or '-'}")


# ---------------------------------------------------------------------------- status, update

def read_manifest(root):
    """(kind, manifest) for a repo, or (None, None) when it has no single manifest."""
    found = [k for k in KINDS if (root / f"{k.upper()}.toml").exists()]
    if len(found) != 1:
        return None, None
    return found[0], load_toml(root / f"{found[0].upper()}.toml")


def read_lock(root):
    try:
        return json.loads((root / LOCK).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def scaffold_names():
    return {"scientific-research-scaffold", HERE.name}


def pin_scaffold_ref(text, ref):
    """Point the CI step that checks out this scaffold at `ref`. Returns (text, the ref it had, or None).

    The one line of a workflow the scaffold owns even after the rest has been edited: in the step whose
    `repository:` is this scaffold, the `ref:` beside it."""
    lines = text.splitlines(keepends=True)
    for i, line in enumerate(lines):
        mrepo = re.match(r"^(\s*)repository:\s*[\"']?[\w.-]+/([\w.-]+?)[\"']?\s*$", line)
        if not mrepo or mrepo.group(2) not in scaffold_names():
            continue
        indent = mrepo.group(1)
        # the `with:` block around it: neighbouring lines at the same indent
        lo = i
        while lo > 0 and lines[lo - 1].startswith(indent) and not lines[lo - 1][len(indent):].startswith((" ", "-")):
            lo -= 1
        hi = i
        while hi + 1 < len(lines) and lines[hi + 1].startswith(indent) and \
                not lines[hi + 1][len(indent):].startswith((" ", "-")):
            hi += 1
        for j in range(lo, hi + 1):
            mref = re.match(r"^(\s*ref:\s*)[\"']?([^\s\"'#]+)[\"']?(.*)$", lines[j].rstrip("\n"))
            if mref:
                old = mref.group(2)
                lines[j] = f"{mref.group(1)}{ref}{mref.group(3)}\n"
                return "".join(lines), old
    return text, None


def find_scaffold_ref(root):
    for wf in sorted((root / ".github" / "workflows").glob("*.y*ml")):
        _, old = pin_scaffold_ref(wf.read_text(encoding="utf-8"), "x")
        if old:
            return old
    return None


def manifest_vars(kind, m, profile):
    v = template_vars(profile, m.get("name", ""), m.get("question") or m.get("job") or "",
                      visibility=str(m.get("visibility", UNDECIDED)),
                      visibility_decided=str(m.get("visibility_decided", "")))
    v["job"] = v["question"]
    return v


def past_renderings(kind, rel, m, pname):
    """Every text an earlier version of this scaffold would have written for `rel`, with that version's
    template and profile. A file matching one of them was never edited, so `update` may replace it.
    Needs this scaffold's git history; without it, nothing matches and files are treated as edited."""
    tpath = template_path(kind, rel).relative_to(HERE).as_posix()
    if tpath.startswith("agents/"):  # the submodule's history isn't this repo's; the lock covers these
        return set()
    code, out, _ = git("rev-list", "--all", "--", tpath, f"profiles/{pname}.toml", cwd=HERE)
    if code:
        return set()
    _, tags, _ = git("tag", "-l", "v*", cwd=HERE)
    refs = ["main", *tags.split()]
    texts = set()
    for sha in out.split():
        tmpl = subprocess.run(["git", "show", f"{sha}:{tpath}"], cwd=HERE,
                              capture_output=True, text=True)
        prof = subprocess.run(["git", "show", f"{sha}:profiles/{pname}.toml"], cwd=HERE,
                              capture_output=True, text=True)
        if tmpl.returncode or prof.returncode:
            continue
        try:
            v = manifest_vars(kind, m, parse_toml(prof.stdout, f"{sha[:7]}:profiles/{pname}.toml"))
            for ref in refs:
                texts.add(fill(tmpl.stdout, {**v, "scaffold_ref": ref}, rel))
        except Exception:  # noqa: BLE001 - an old template this version cannot fill matches nothing
            continue
    return texts


def adopted(rel, adopt):
    """--adopt names a file, or a folder of them (such as .claude/agents)."""
    return any(rel == a.rstrip("/") or rel.startswith(a.rstrip("/") + "/") for a in adopt)


def plan_update(root, adopt=()):
    """What `update` would do to each file the scaffold owns: (file, action, current text, new text, note).

    add      missing from a repo the scaffold made (it has .scaffold.lock); the scaffold writes it
    missing  missing from a repo that adopted the protocol, which may do the job its own way; reported
             only (`--adopt FILE` adds it)
    current  already what this release writes
    update   unedited since the scaffold wrote it (per .scaffold.lock, or matching an earlier release's
             output); replaced
    pin      edited, but its scaffold `ref:` is behind; only that line changes
    edited   edited; kept as it is, with the difference shown (`--adopt FILE` replaces it)"""
    kind, m = read_manifest(root)
    if kind is None:
        raise Fail(f"{root.name}: no single STUDY.toml / SIM.toml / TOOL.toml, so nothing to update")
    if kind == "sim" and root.parent.name == "sims" and (root.parent.parent / "STUDY.toml").exists():
        raise Fail(f"{root.name} is a sim inside a study and shares the study's files: update the study")
    pname = profile_name(None, m)
    profile = load_profile(pname)
    v = manifest_vars(kind, m, profile)
    lock = read_lock(root)
    recorded = lock.get("files", {})
    made = bool(lock) and not lock.get("adopted")  # made by the scaffold, so a missing file is its to add
    plan = []
    for rel in owned_files(kind, profile):
        new = render_owned(kind, rel, v, profile)
        path = root / rel
        if not path.exists():
            if made or adopted(rel, adopt):
                plan.append((rel, "add", "", new, ""))
            else:
                plan.append((rel, "missing", "", new, "this repo adopted the scaffold; --adopt to add"))
            continue
        cur = path.read_text(encoding="utf-8")
        if cur == new:
            plan.append((rel, "current", cur, new, ""))
        elif adopted(rel, adopt):
            plan.append((rel, "update", cur, new, "adopted: your edits are replaced"))
        elif recorded.get(rel) == sha256(cur):
            plan.append((rel, "update", cur, new, "unedited since the scaffold wrote it"))
        elif cur in past_renderings(kind, rel, m, pname):
            plan.append((rel, "update", cur, new, "matches what an earlier release wrote"))
        else:
            pinned, old = pin_scaffold_ref(cur, SCAFFOLD_REF) if rel.startswith(".github/") else (cur, None)
            if old and pinned != cur:
                plan.append((rel, "pin", cur, pinned, f"edited; only the scaffold ref moves, {old} -> {SCAFFOLD_REF}"))
            else:
                plan.append((rel, "edited", cur, new, "edited; kept (--adopt to replace)"))
    # The scaffold's section of AGENTS.md is the scaffold's by its markers; the rest of the file is not.
    agents_md = root / "AGENTS.md"
    cur = agents_md.read_text(encoding="utf-8") if agents_md.exists() else ""
    new = with_block(cur, agents_block(kind, v, profile))
    if cur == new:
        plan.append(("AGENTS.md", "current", cur, new, ""))
    elif BLOCK_START in cur or made or adopted("AGENTS.md", adopt):
        plan.append(("AGENTS.md", "update" if BLOCK_START in cur else "add", cur, new, "only the scaffold's section"))
    else:
        plan.append(("AGENTS.md", "missing", cur, new, "no scaffold section; --adopt AGENTS.md to add one"))
    settings = root / SETTINGS
    cur = settings.read_text(encoding="utf-8") if settings.exists() else ""
    try:
        new = with_session_hook(cur)
    except ValueError:
        plan.append((str(SETTINGS), "edited", cur, cur, "not valid JSON; kept"))
        return kind, profile, plan
    rel = str(SETTINGS)
    if cur and json.loads(cur) == json.loads(new):
        plan.append((rel, "current", cur, cur, ""))
    elif HOOK_MARK in cur or made or adopted(rel, adopt):
        plan.append((rel, "update" if HOOK_MARK in cur else "add", cur, new, "only the scaffold's session hook"))
    else:
        plan.append((rel, "missing", cur, new, "no scaffold session hook; --adopt .claude/settings.json to add it"))
    return kind, profile, plan


def show_diff(rel, old, new, limit=40):
    lines = list(difflib.unified_diff(old.splitlines(keepends=True), new.splitlines(keepends=True),
                                      f"a/{rel}", f"b/{rel}"))
    for line in lines[:limit]:
        print("      " + line.rstrip("\n"))
    if len(lines) > limit:
        print(f"      ... {len(lines) - limit} more line(s)")


def cmd_update(a):
    root = Path(a.path).resolve()
    kind, profile, plan = plan_update(root, adopt=set(a.adopt or ()))
    unknown = {x for x in a.adopt or () if not any(adopted(rel, [x]) for rel, *_ in plan)}
    if unknown:
        raise Fail(f"--adopt names files the scaffold does not own here: {', '.join(sorted(unknown))}")
    print(f"{root.name} ({kind}), to scaffold {SCAFFOLD_REF}:")
    have = parse_version(read_lock(root).get("scaffold"))
    notes = upgrade_notes(have, parse_version(SCAFFOLD_REF)) if have else []
    for rel, action, cur, new, note in plan:
        print(f"  {action:8} {rel}" + (f"  ({note})" if note else ""))
        if action not in ("current", "missing"):
            show_diff(rel, cur, new)
    writes = [(rel, new) for rel, action, _, new, _ in plan if action in ("add", "update", "pin")]
    if notes:
        print("\nThen, by hand or by a session with the person's go-ahead (UPGRADING.md):")
        for note in notes:
            print("\n" + note)
        print()
    if not a.apply:
        print("dry run: nothing written." + (" Run with --apply to write the changes above." if writes else ""))
        return 0
    if writes:
        # .scaffold.lock is left out: it is the scaffold's own record, and rewriting it loses nothing of yours.
        code, dirty, _ = git("status", "--porcelain", "--", *[r for r, _ in writes], cwd=root)
        if code:
            raise Fail(f"{root} is not a git repo; update writes only where git can show and undo the change")
        if dirty:
            raise Fail(f"uncommitted changes in files update would write; commit or stash them first:\n{dirty}")
    for rel, new in writes:
        (root / rel).parent.mkdir(parents=True, exist_ok=True)
        (root / rel).write_text(new, encoding="utf-8")
    # Record only the files that are now exactly the scaffold's: an edited or pinned file is the repo's own.
    ours = {rel for rel, action, *_ in plan if action in ("add", "update", "current")}
    prior = read_lock(root)
    write_lock(root, kind, profile, only=ours, adopted=not prior or bool(prior.get("adopted")))
    print(f"wrote {len(writes)} file(s) and {LOCK}. Review with `git diff`, run `scaffold check`, then commit.")
    return 0


def cmd_status(a):
    rows = []
    for p in a.paths or ["."]:
        root = Path(p).resolve()
        if not root.is_dir():
            continue
        try:
            kind, m = read_manifest(root)
        except Exception as e:  # noqa: BLE001 - one broken repo must not stop the survey
            rows.append((root.name, "?", "", "", "", f"manifest does not parse: {e}", ""))
            continue
        if kind is None:
            rows.append((root.name, "-", "", "", "", "no manifest", ""))
            continue
        rep = Report(root)
        check_repo(root, rep)
        checked = "ok" if not rep.fails else f"{len(rep.fails)} failure(s)"
        if rep.warns:
            checked += f", {len(rep.warns)} warning(s)"
        try:
            _, _, plan = plan_update(root)
            todo, agents = [], {}
            for rel, action, *_ in plan:
                if action not in ("add", "update", "pin", "missing"):
                    continue
                if rel.startswith(".claude/") and rel != str(SETTINGS):  # one entry for the agent files
                    agents[action] = agents.get(action, 0) + 1
                else:
                    todo.append(f"{action} {rel}")
            todo += [f"{action} {n} agent file(s)" for action, n in agents.items()]
            kept = sum(action == "edited" for _, action, *_ in plan)
            pending = "; ".join(todo) or "up to date"
            if kept:
                pending += f" ({kept} edited file(s) kept as yours)"
        except Fail as e:
            pending = str(e).split(":")[-1].strip() if "inside a study" in str(e) else f"? {e}"
        rows.append((root.name, kind, str(m.get("stage", "")), read_lock(root).get("scaffold", "unrecorded"),
                     find_scaffold_ref(root) or "-", checked, pending))
    head = ("repo", "kind", "stage", "scaffold", "CI ref", "check", "update")
    widths = [max(len(r[i]) for r in [head, *rows]) for i in range(len(head) - 1)]
    for r in [head, *rows]:
        print("  ".join(c.ljust(w) for c, w in zip(r, widths)) + "  " + r[-1])
    return 0


# -------------------------------------------------------------------------------------- usage

def cmd_usage(a):
    """Tokens and cost per repo: scientific-research-agents' `usage`, which this passes through to."""
    tool = AGENTS_DIR / "bin" / "agents"
    if not tool.exists():
        raise Fail(f"{tool} is missing: run `git submodule update --init` in {HERE}")
    args = [*(a.paths or ["."]), "--days", str(a.days), *(["--all"] if a.all else [])]
    return subprocess.run([sys.executable, str(tool), "usage", *args]).returncode


# ------------------------------------------------------------------------------------ version

def parse_version(v):
    m = re.fullmatch(r"v?(\d+)\.(\d+)\.(\d+)", str(v or "").strip())
    return tuple(int(x) for x in m.groups()) if m else None


def upgrade_notes(since, upto):
    """The UPGRADING.md sections for releases after `since`, up to and including `upto`, oldest first."""
    text = (HERE / "UPGRADING.md").read_text(encoding="utf-8")
    parts = re.split(r"^## ", text, flags=re.M)[1:]
    notes = []
    for part in parts:
        head, _, body = part.partition("\n")
        v = parse_version(head.split()[0])
        if v and (since is None or v > since) and v <= upto:
            notes.append((v, f"## {head}\n{body.strip()}"))
    return [n for _, n in sorted(notes)]


def latest_release(timeout=4):
    """The newest vX.Y.Z tag of this scaffold's origin, or None when it can't be reached quickly."""
    try:
        r = subprocess.run(["git", "ls-remote", "--tags", "origin"], cwd=HERE, capture_output=True, text=True,
                           timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    tags = [parse_version(line.rsplit("/", 1)[-1].replace("^{}", "")) for line in r.stdout.splitlines()]
    return max((t for t in tags if t), default=None)


def cmd_version(a):
    root = Path(a.path).resolve()
    try:
        kind, _ = read_manifest(root)
    except Exception:  # noqa: BLE001 - a session hook must never fail the session
        kind = None
    if kind is None:
        if not a.hook:
            print(f"{root.name}: not a repo made with scientific-research-scaffold (no single manifest)")
        return 0
    say = print if not a.hook else (lambda m: print(f"scientific-research-scaffold: {m}"))
    have, current = read_lock(root).get("scaffold"), parse_version(SCAFFOLD_REF)
    remote = None if a.offline else latest_release()
    fmt = "v{}.{}.{}".format
    if remote and remote > current:
        say(f"release {fmt(*remote)} is out, but the scaffold checkout at {HERE} is {SCAFFOLD_REF}. Pull it "
            f"(`git -C {HERE} pull --recurse-submodules`), then run `scaffold version` again.")
    if not have:
        say(f"{root.name} has no .scaffold.lock, so the scaffold release it follows is unknown. Run `scaffold update` "
            f"(a dry run) to see what {SCAFFOLD_REF} would change; `--apply` records the release.")
        return 0
    if parse_version(have) and parse_version(have) < current:
        say(f"{root.name} follows scaffold {have}; {SCAFFOLD_REF} is available. "
            + ("Tell the person, and offer to upgrade by following these steps. " if a.hook else "")
            + "To upgrade: `scaffold update` (a dry run), `scaffold update --apply`, then the session steps below, "
              "oldest first, then `scaffold check`.")
        for note in upgrade_notes(parse_version(have), current):
            print("\n" + note)
    elif not a.hook:
        print(f"{root.name} follows scaffold {have}, the release this checkout is ({SCAFFOLD_REF}).")
    return 0


# --------------------------------------------------------------------------------------- main

def main(argv=None):
    ap = argparse.ArgumentParser(prog="scaffold", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    n = sub.add_parser("new", help="create a study, a sim, or an app inside a study")
    n.add_argument("kind", choices=("study", "sim", "tool", "workbench", "app", *UNITS))
    n.add_argument("name", help="the subject, no kind prefix (for an app: its slug)")
    n.add_argument("--question", "-q", help="the question it asks (or what a sim simulates; with --exploratory, "
                                            "what is being built)")
    n.add_argument("--hypothesis", help="for a study: the person's hypothesis, preserved verbatim in HYPOTHESIS.toml")
    n.add_argument("--job", "-j", help="for a tool: what it does for the repos that use it")
    n.add_argument("--exploratory", action="store_true",
                   help="for a unit: no claim yet. --question (or --job) says what is being built; the unit is "
                        "labelled exploratory and nothing it shows is a finding")
    n.add_argument("--hypothesis-element", action="append", default=[], metavar="ID",
                   help="accepted study element this unit derives from; repeat for more (the first is its scope)")
    n.add_argument("--profile", help="profile name (default: $SCAFFOLD_PROFILE; there is no built-in default)")
    n.add_argument("--visibility", choices=VISIBILITIES,
                   help="record a visibility decision already made (default: left undecided; check fails until set)")
    n.add_argument("--dir", default=".", help="parent directory for a new repo")
    n.add_argument("--inside", help="create it inside this study or workbench: a study inside a workbench; "
                                    "a sim or tool inside either; or a sim inside a tool, as a comparison unit")
    n.add_argument("--compares", action="append", default=[], metavar="TOOL",
                   help="for a sim or dataset inside a tool: another tool it compares the tool with, with its "
                        "version (repeat for more)")
    n.add_argument("--study", default=".", help="for an app, dataset or calculator: the study to add it to "
                                               "(a dataset may also go in a tool, as a comparison unit)")
    n.add_argument("--kit-ap", help="path to kit_ap or a checkout of the prereg kit")
    n.add_argument("--no-git", action="store_true", help="do not git init, commit, or install the kit")
    n.set_defaults(fn=cmd_new)

    p = sub.add_parser("promote-sim", help="move a sim out of a study into its own repo, with history")
    p.add_argument("path")
    p.add_argument("--dir", default="..", help="parent directory for the new repo")
    p.set_defaults(fn=cmd_promote)

    lh = sub.add_parser("link-hypothesis", help="associate an existing study unit with accepted hypothesis elements")
    lh.add_argument("unit", help="registered unit path, for example apps/listener/v1")
    lh.add_argument("--element", action="append", default=[], metavar="ID",
                    help="accepted element the unit bears on; repeat for more")
    lh.add_argument("--scope-element", metavar="ID", help="primary element for the unit's local scope")
    lh.add_argument("--role", required=True, help="one sentence saying how this unit bears on the elements")
    lh.add_argument("--path", default=".", help="study root (default: current directory)")
    lh.set_defaults(fn=cmd_link_hypothesis)

    sh = sub.add_parser("sync-hypothesis", help="flag stale unit links across one or more affected studies")
    sh.add_argument("paths", nargs="*", help="affected study roots selected from corpus reverse references")
    sh.set_defaults(fn=cmd_sync_hypothesis)

    c = sub.add_parser("check", help="check a repo against the protocol")
    c.add_argument("path", nargs="?", default=".")
    c.set_defaults(fn=cmd_check)

    st = sub.add_parser("status", help="one line per repo: kind, stage, scaffold version, CI ref, check, update")
    st.add_argument("paths", nargs="*", help="repos to survey (default: this one), e.g. ~/code/*")
    st.set_defaults(fn=cmd_status)

    u = sub.add_parser("update", help="bring the files the scaffold owns up to this release (dry run by default)")
    u.add_argument("path", nargs="?", default=".")
    u.add_argument("--apply", action="store_true", help="write the changes (needs those files committed first)")
    u.add_argument("--adopt", action="append", metavar="FILE",
                   help="replace an edited file, or add a missing one, anyway; a folder adopts all in it (repeatable)")
    u.set_defaults(fn=cmd_update)

    us = sub.add_parser("usage", help="tokens and API-equivalent cost per repo, from Claude Code and Codex logs")
    us.add_argument("paths", nargs="*", help="repos to report (default: this one)")
    us.add_argument("--days", type=int, default=7, help="how far back to look (default 7)")
    us.add_argument("--all", action="store_true", help="every project that has sessions, not just PATHs")
    us.set_defaults(fn=cmd_usage)

    ve = sub.add_parser("version", help="whether a repo follows the current scaffold, and how to upgrade it")
    ve.add_argument("path", nargs="?", default=".")
    ve.add_argument("--hook", action="store_true", help="for a session hook: quiet when up to date, never fails")
    ve.add_argument("--offline", action="store_true", help="don't check GitHub for a newer release")
    ve.set_defaults(fn=cmd_version)

    sub.add_parser("profiles", help="list profiles").set_defaults(fn=cmd_profiles)

    a = ap.parse_args(argv)
    try:
        return a.fn(a) or 0
    except Fail as e:
        print(f"scaffold: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
